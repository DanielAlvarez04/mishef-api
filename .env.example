# Naranja Pimienta — API variables de entorno (ejemplo, sin secretos reales)

NODE_ENV=development
PORT=3001

# Base de datos PostgreSQL (Docker Desktop, puerto 55432 en el host)
DATABASE_URL="postgresql://np_user:np_password@localhost:55432/np_db?schema=public"

# Origen del frontend (para CORS y cookies)
WEB_ORIGIN="http://localhost:3000"

# Origen público de la API (se acepta como Origin válido para Swagger y CSRF)
API_PUBLIC_ORIGIN="http://localhost:3001"

# Cookies (ajustar según despliegue)
COOKIE_DOMAIN=

# JWT secretos (cambiar en producción, nunca subir valores reales al repositorio)
JWT_ACCESS_SECRET="cambiar-en-produccion"
JWT_REFRESH_SECRET="cambiar-en-produccion"

# Basic auth de la documentación (Swagger en /docs*). En producción son
# obligatorias: el arranque falla si faltan. En desarrollo, si se dejan vacías,
# /docs queda accesible sin credenciales.
SWAGGER_USER=
SWAGGER_PASSWORD=

# Correo (Resend). En desarrollo, si el remitente no es un dominio verificado,
# los correos se guardan en api/.mail-outbox/mails.jsonl y no se llama a Resend.
RESEND_API_KEY=
RESEND_FROM_EMAIL="no-reply@naranjapimienta.local"

# Cloudflare R2 para imágenes (bucket público `mishef-public`).
# El navegador sube el original a `{org}/tmp/` con una URL firmada (PUT) y luego
# llama a `finalize`: la API lo descarga, genera AVIF (calidad 70) + JPEG en
# 640 y 1280 px, guarda solo esas variantes y borra el original. En el bucket
# nunca queda la imagen tal como se subió.
# Estructura final:
#   {org}/{página}/{id}/{hash}-{ancho}x{alto}-{640|1280}.{avif|jpg}
#   {org}/catalog/{entryId}/variants/{variantId}/...   (presentación)
# Los objetos llevan hash y `Cache-Control: immutable`, así que nunca se
# reescriben. Una regla de ciclo de vida sobre `{org}/tmp/` debe borrar lo que
# quede de subidas abandonadas (recomendado: 1 día).
# CORS del bucket: AllowedOrigins = WEB_ORIGIN, AllowedMethods = GET, PUT, HEAD
# y AllowedHeaders = Content-Type (el navegador hace preflight del PUT).
# R2 todavía no soporta presigned POST: no cambiar la subida a POST.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET="mishef-public"
# Dominio público del bucket, sin barra final. En producción usa un dominio
# propio proxeado por Cloudflare (p. ej. https://img.mishef.co) y una Cache
# Rule "Cache Everything": el dominio `*.r2.dev` no cachea en el borde y está
# limitado, así que cada visita acabaría siendo una operación Clase B.
R2_PUBLIC_BASE_URL=
# Opcional: endpoint S3 alternativo (por defecto se deriva de R2_ACCOUNT_ID)
R2_ENDPOINT=
# Tamaño máximo por imagen en bytes (5 MB)
R2_MAX_UPLOAD_BYTES=5242880

# Google OAuth (opcional). Si se configuran ambas, se habilita /v1/auth/google.
# La redirect URI debe coincidir exactamente con la registrada en Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Por defecto: ${API_PUBLIC_ORIGIN}/v1/auth/google/callback
GOOGLE_REDIRECT_URI=

# Mercado Pago Point (opcional). Si se configura cualquier variable del bloque,
# deben estar todas. Se obtienen en "Tus integraciones" de Mercado Pago.
# MP_REDIRECT_URI debe coincidir exactamente con la registrada en la aplicación:
#   ${API_PUBLIC_ORIGIN}/v1/mercadopago/callback
# MP_TOKEN_ENCRYPTION_KEY: clave de 32 bytes en base64. Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# MP_ENVIRONMENT declara el entorno de la aplicación: `production` o `test`.
# NO se infiere del prefijo del token: las credenciales de prueba nuevas de
# Mercado Pago también empiezan con `APP_USR-`.
# MP_OAUTH_PKCE solo se activa si el panel de la app tiene PKCE habilitado.
# MP_WEBHOOK_MAX_SKEW_SECONDS=0 desactiva la ventana de antigüedad de la firma
# (recomendado: 600 en producción si el reloj está sincronizado).
MP_CLIENT_ID=
MP_CLIENT_SECRET=
MP_REDIRECT_URI=
MP_WEBHOOK_SECRET=
MP_TOKEN_ENCRYPTION_KEY=
MP_ENVIRONMENT=production
MP_OAUTH_PKCE=false
MP_WEBHOOK_MAX_SKEW_SECONDS=0
# Días que se conservan los payloads de webhooks antes de vaciarlos con
# `npm run webhooks:prune` (cron diario).
MP_WEBHOOK_RETENTION_DAYS=30
# Opcionales: identificadores que Mercado Pago asigna a la plataforma/integrador.
MP_PLATFORM_ID=
MP_INTEGRATOR_ID=
MP_SPONSOR_ID=

# Suscripciones de la plataforma (aplicación "Mishef Suscripciones").
# El access token pertenece a la cuenta de Mishef que recibe los cobros.
# El webhook se configura en la app:
#   ${API_PUBLIC_ORIGIN}/v1/webhooks/mercadopago-billing
# MP_BILLING_ENVIRONMENT: `production` o `test`, explícito (igual que arriba).
MP_BILLING_ACCESS_TOKEN=
MP_BILLING_WEBHOOK_SECRET=
MP_BILLING_ENVIRONMENT=production
MP_BILLING_WEBHOOK_MAX_SKEW_SECONDS=0
# URL HTTPS de retorno después del checkout de suscripción.
MP_BILLING_BACK_URL=https://app.mishef.co/billing

# Cloudflare Turnstile (anti-bots en el registro). Si está vacío, el registro
# funciona sin captcha. El widget se crea en el panel de Cloudflare.
TURNSTILE_SECRET=""

# Dominio base de los negocios. Con el se arma el CNAME del dominio propio
# (micafeteria.mishef.co) y se valida el destino al verificar el DNS.
TENANT_DOMAIN="mishef.co"

# Cloudflare for SaaS: al verificar un dominio propio se registra como custom
# hostname para que Cloudflare emita su certificado. Sin el token, el flujo
# sigue funcionando pero el TLS del dominio lo resuelve el cliente.
CF_SAAS_TOKEN=""
CF_SAAS_ZONE_ID=""
# Hostname público del fallback origin (CNAME que pone el cliente).
SAAS_FALLBACK_ORIGIN="saas.mishef.co"

# --- Intel (IA) -------------------------------------------------------------
# Proveedor OpenAI-compatible. Sin clave el módulo queda deshabilitado y
# /v1/intel/chat responde 503.
#
# Recomendado en producción: NVIDIA NIM como principal y OpenRouter como
# respaldo. OpenCode Go queda para desarrollo: su cuota gratuita es limitada
# y no es una API multiinquilino de producción.
#
# Las claves se pueden poner directas (INTEL_API_KEY) o indicar el nombre de
# una variable existente (INTEL_API_KEY_ENV). La segunda opción evita duplicar
# secretos en el .env.
NVIDIA_API_KEY=""
OPENROUTER_API_KEY=""

INTEL_PROVIDER="nvidia"
INTEL_BASE_URL="https://integrate.api.nvidia.com/v1"
INTEL_API_KEY_ENV="NVIDIA_API_KEY"
# Modelos vigentes verificados el 2026-11-20. Los IDs de Llama 3.x anteriores
# están retirados (410 Gone) en la API hospedada.
# NVIDIA hospedado: gratis para prototipo con rate limits; producción requiere
# NVIDIA AI Enterprise. Para producción a 50 restaurantes, evalúa un proveedor
# pago (OpenRouter/OpenAI/Google) o AI Enterprise.
INTEL_MODEL="nvidia/nemotron-3.5-bolt-e4b"
# Respaldo del mismo proveedor, en orden. El servicio solo cambia de modelo si
# el anterior falla antes de emitir texto.
INTEL_FALLBACK_MODELS="nvidia/nemotron-3-ultra-550b-a55b,nvidia/nemotron-3.5-lightning-30b-a3b"
# Visión para tickets (Fase 2).
INTEL_VISION_MODEL="nvidia/nemotron-3.5-super-vl-120b-a12b"

# Respaldo de otro proveedor (opcional). Ejemplo OpenRouter:
# INTEL_FALLBACK_PROVIDER="openrouter"
# INTEL_FALLBACK_BASE_URL="https://openrouter.ai/api/v1"
# INTEL_FALLBACK_API_KEY_ENV="OPENROUTER_API_KEY"
# INTEL_FALLBACK_MODEL=""

# OpenCode Go (solo desarrollo; cuota gratuita limitada):
# INTEL_PROVIDER="opencode"
# INTEL_BASE_URL="https://opencode.ai/inference/openai/v1"
# INTEL_API_KEY_ENV="OC_API_KEY"
# INTEL_MODEL="beam-free"
# INTEL_FALLBACK_MODELS="flint-40b-free,iceman-free"

# Cuota mensual de tokens por organización. 500k por defecto.
INTEL_MONTHLY_TOKEN_LIMIT=500000
