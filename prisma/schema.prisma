// Naranja Pimienta — Esquema de base de datos (PostgreSQL 16)
// Prisma 7
//
// Notas de diseño:
// - `Membership` es la única fuente de verdad de la pertenencia usuario ↔ organización.
// - Un usuario puede tener varios roles dentro de una organización (`Membership.roles`).
// - La tasa de IVA es un ajuste del negocio (`Organization.taxRate`, 16 % por defecto) y
//   se aplica a los productos que no tengan una tasa propia (`Product.taxRate`).
// - Los precios del catálogo son precios finales con IVA incluido (`plan.md` §6.9).
// - Los estados son enums para que la base de datos rechace valores inválidos.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// Enums
// ============================================================================

enum Role {
  ADMIN
  WAITER
  KITCHEN
  CASHIER
  INVENTORY_MANAGER
}

enum OrderStatus {
  OPEN
  CLOSED
  CANCELLED
}

enum OrderRoundStatus {
  PENDING
  PREPARING
  READY
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  REFUNDED
}

enum InventoryMovementType {
  ADJUSTMENT
  CONSUMPTION
  RETURN
  PRODUCTION
}

enum TwoFactorPurpose {
  LOGIN
  ENABLE
}

/// Unidad de medida. La dimensión y el factor a la unidad base viven en código
/// (`src/common/units.ts`): masa (base g), volumen (base ml) y conteo (base
/// pieza = UNIT). El catálogo es fijo: no se edita desde la aplicación.
enum UnitCode {
  MG
  G
  KG
  OZ
  LB
  ML
  L
  TSP
  TBSP
  CUP
  FL_OZ
  GAL
  UNIT
  HALF_PIECE
  PAIR
  HALF_DOZEN
  DOZEN
}

/// Tipo de categoría: agrupa artículos vendibles o recetas/preparaciones.
enum CategoryKind {
  ARTICLE
  RECIPE
}

/// Cómo se elige dentro de un grupo de opciones.
enum OptionSelection {
  SINGLE
  MULTIPLE
}

/// Efecto de una opción sobre la receta de un artículo.
enum OptionEffectAction {
  ADD
  REPLACE
  REMOVE
}

/// Tipo de promoción configurable de un combo.
enum PromotionType {
  PERCENT
  FIXED
  BOGO
}

// ============================================================================
// Identidad y organización
// ============================================================================

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  domain    String?  @unique // dominio de los usuarios del equipo (ej. naranjapimienta.cafe)
  taxRate   Decimal  @default(0.16) @db.Decimal(5, 4) // IVA por defecto del negocio (0.16 = 16 %)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Onboarding fields
  businessType        String? // Giro principal: restaurante, cafetería, etc.
  serviceTypes        String[] @default([]) // Modelo de servicio: mesa, mostrador, etc.
  goals               String[] @default([]) // Objetivos: inventario, costos, etc.
  hasBranches         Boolean  @default(false) // "Tengo sucursales"
  /// Mostrar/activar la sección de insumos core sugeridos en Configuración.
  useCoreSuggestions  Boolean  @default(true)
  /// Mostrar/activar los grupos de opciones core sugeridos en el editor de artículos.
  useCoreOptionGroups Boolean  @default(true)

  memberships          Membership[]
  branches             Branch[]
  orders               Order[]
  payments             Payment[]
  inventoryMovements   InventoryMovement[]
  auditLogs            AuditLog[]
  categories           Category[]
  items                Item[]
  ingredients          Ingredient[]
  recipes              Recipe[]
  catalogEntries       CatalogEntry[]
  ingredientCategories IngredientCategory[]
  ingredientLocations  IngredientLocation[]
  optionGroups         OptionGroup[]
  menus                Menu[]
}

model User {
  id               String    @id @default(cuid())
  email            String?   @unique
  username         String?   @unique // login de cuentas internas (minúsculas)
  passwordHash     String?
  name             String?
  googleId         String?   @unique // `sub` de Google (OpenID Connect)
  isActive         Boolean   @default(true)
  emailVerified    Boolean   @default(false)
  twoFactorEnabled Boolean   @default(false)
  onboardedAt      DateTime? // null hasta completar el onboarding
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  memberships            Membership[]
  authSessions           AuthSession[]
  twoFactorCodes         TwoFactorCode[]
  orders                 Order[]
  payments               Payment[]               @relation("PaymentUser")
  confirmedPayments      Payment[]               @relation("PaymentConfirmedBy")
  inventoryMovements     InventoryMovement[]
  auditLogs              AuditLog[]
  emailVerificationToken EmailVerificationToken?
  passwordResetToken     PasswordResetToken?
  orderStatusHistories   OrderStatusHistory[]

  @@index([isActive])
}

model Membership {
  id             String   @id @default(cuid())
  userId         String
  organizationId String?
  branchId       String? // null = acceso a todas las sucursales
  roles          Role[]   @default([WAITER])
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([branchId])
}

/// Sucursal física del negocio. Por ahora agrupa al personal; el inventario y
/// los pedidos se irán vinculando por fases para no mezclar existencias.
model Branch {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  address        String?
  phone          String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships  Membership[]
  stock        BranchStock[]
  movements    InventoryMovement[]
  orders       Order[]
  payments     Payment[]

  @@unique([organizationId, name])
  @@index([organizationId, isActive])
}

/// Existencia de un ingrediente en una sucursal concreta.
///
/// `Ingredient.currentStock` sigue siendo el total de la organización; este
/// registro permite operar cada local por separado sin perder el consolidado.
model BranchStock {
  id           String   @id @default(cuid())
  branchId     String
  ingredientId String
  quantity     Decimal  @default(0.0000) @db.Decimal(12, 4)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  branch     Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@unique([branchId, ingredientId])
  @@index([ingredientId])
}

model AuthSession {
  id                  String    @id @default(cuid())
  userId              String
  refreshTokenHash    String    @unique
  expiresAt           DateTime // expiración del refresh token actual
  absoluteExpiresAt   DateTime // expiración absoluta de la sesión (límite de rotación)
  revokedAt           DateTime?
  revokedReason       String? // "LOGOUT", "ROTATED", "REUSE_DETECTED", "PASSWORD_CHANGED"
  replacedBySessionId String?
  userAgent           String?
  ip                  String?
  lastUsedAt          DateTime?
  createdAt           DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String    @unique
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TwoFactorCode {
  id         String           @id
  userId     String
  purpose    TwoFactorPurpose
  codeHash   String
  expiresAt  DateTime
  attempts   Int              @default(0)
  consumedAt DateTime?
  createdAt  DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, createdAt])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String    @unique
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============================================================================
// Catálogo
// ============================================================================

model Category {
  id             String       @id @default(cuid())
  organizationId String?
  /// Identificador estable de las categorías core (breakfast, sauces, …).
  code           String?
  name           String
  description    String?
  isCore         Boolean      @default(false) // true = parte del core, no editable
  kind           CategoryKind @default(ARTICLE)
  isActive       Boolean      @default(true)
  sortOrder      Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  items        Item[]
  recipes      Recipe[]

  @@unique([organizationId, kind, name])
  @@unique([kind, code])
  @@index([organizationId])
  @@index([kind, isCore])
}

/// Identidad global de un elemento del catálogo (artículo, receta o ambos).
///
/// Su `id` es la carpeta estable en R2: `{organización}/catalog/{id}/`.
/// La comparten la receta y el artículo que la publica, así que la ruta de la
/// imagen no cambia al publicar ni al despublicar y nunca hay dos objetos.
model CatalogEntry {
  id             String   @id @default(cuid())
  organizationId String?
  imageKey       String? // Objeto en R2 (nombre hasheado); la URL se deriva
  imageUrl       String?
  /// Nombre normalizado y legible de la imagen (sin guiones ni extensión).
  imageName      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  items        Item[]
  recipes      Recipe[]

  @@index([organizationId])
}

/// Artículo del catálogo (lo que se vende en el POS).
/// La tabla sigue llamándose `Product` para no migrar la base.
model Item {
  id             String   @id @default(cuid())
  organizationId String?
  categoryId     String?
  /// Identidad del catálogo: dueña de la imagen y de la carpeta en R2.
  catalogEntryId String?  @unique
  name           String
  description    String?
  sku            String? // Código interno / importación CSV
  price          Decimal  @db.Decimal(12, 2) // Precio final con IVA incluido
  taxRate        Decimal? @db.Decimal(5, 4) // Tasa aplicable; null = no configurada (no se asume ninguna)
  isActive       Boolean  @default(true)
  isCombo        Boolean  @default(false)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization         Organization?             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category             Category?                 @relation(fields: [categoryId], references: [id])
  catalogEntry         CatalogEntry?             @relation(fields: [catalogEntryId], references: [id], onDelete: SetNull)
  variants             ItemVariant[]
  extras               ItemExtra[]
  recipes              Recipe[]
  orderItems           OrderItem[]               @relation("OrderItemRef")
  ingredientExclusions ItemIngredientExclusion[]
  optionGroups         ItemOptionGroup[]
  promotions           ComboPromotion[]
  comboComponents      ComboComponent[]          @relation("ComboComponents")
  componentOf          ComboComponent[]          @relation("ComboPartOf")
  menuItems            MenuItem[]

  @@unique([organizationId, sku])
  @@index([organizationId, isActive])
  @@index([categoryId])
  @@map("Product")
}

model ItemVariant {
  id           String   @id @default(cuid())
  itemId       String   @map("productId")
  name         String // ej: "Chico", "Regular", "Grande", "Sin azúcar"
  /// SKU propio: el del artículo más el sufijo de la presentación (XVA101A).
  sku          String?
  /// Presentación que el menú muestra por defecto. Solo una por artículo.
  isPrimary    Boolean  @default(false)
  priceAdjust  Decimal  @default(0.0000) @db.Decimal(12, 2)
  /// Multiplicador del consumo de la receta base. Regular = 1.
  recipeFactor Decimal  @default(1) @db.Decimal(6, 3)
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  item            Item             @relation(fields: [itemId], references: [id], onDelete: Cascade)
  orderItems      OrderItem[]
  recipes         Recipe[]
  recipeIngredients RecipeIngredient[]
  comboComponents ComboComponent[]

  @@index([itemId])
  @@map("ProductVariant")
}

model ItemExtra {
  id        String   @id @default(cuid())
  itemId    String   @map("productId")
  name      String
  price     Decimal  @db.Decimal(12, 2)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  item            Item                  @relation(fields: [itemId], references: [id], onDelete: Cascade)
  orderItemExtras OrderItemExtra[]
  ingredients     ItemExtraIngredient[]

  @@index([itemId])
  @@map("ProductExtra")
}

// ============================================================================
// Opciones configurables (grupos, valores y efectos)
// ============================================================================

/// Grupo de opciones del negocio (salsas, proteínas, leches, extras, "sin…").
/// Los grupos sugeridos por la app son plantillas: al usarlos se crea uno
/// propio de la organización para que se pueda editar sin afectar a otros.
model OptionGroup {
  id             String   @id @default(cuid())
  organizationId String?
  name           String
  description    String?
  sortOrder      Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization?     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  values       OptionValue[]
  itemGroups   ItemOptionGroup[]

  @@unique([organizationId, name])
  @@index([organizationId, isActive])
}

/// Valor de un grupo ("Salsa roja", "Bistec", "Leche de almendra").
model OptionValue {
  id           String   @id @default(cuid())
  groupId      String
  name         String
  /// Texto que se muestra a cocina; si falta se usa `name`.
  kitchenLabel String?
  sortOrder    Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  group      OptionGroup       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  itemValues ItemOptionValue[]

  @@unique([groupId, name])
  @@index([groupId])
}

/// Asignación de un grupo a un artículo, con sus reglas de selección.
model ItemOptionGroup {
  id         String          @id @default(cuid())
  itemId     String
  groupId    String
  isRequired Boolean         @default(false)
  selection  OptionSelection @default(SINGLE)
  minSelect  Int             @default(0)
  maxSelect  Int?
  sortOrder  Int             @default(0)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  item   Item              @relation(fields: [itemId], references: [id], onDelete: Cascade)
  group  OptionGroup       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  values ItemOptionValue[]

  @@unique([itemId, groupId])
  @@index([itemId])
  @@index([groupId])
}

/// Valor del grupo para un artículo concreto: aquí vive el precio y el default.
/// El mismo valor ("Bistec") puede costar distinto en dos platillos.
///
/// Si `valueId` viene de la biblioteca. Si es null, `customName` guarda una
/// opción propia del artículo que no modifica el grupo de la biblioteca.
model ItemOptionValue {
  id                String   @id @default(cuid())
  itemOptionGroupId String
  valueId           String?
  /// Opción propia del artículo (no existe en la biblioteca).
  customName        String?
  priceDelta        Decimal  @default(0) @db.Decimal(12, 2)
  /// Multiplicador del consumo de la receta para esta opción (tamaños).
  scaleFactor       Decimal  @default(1) @db.Decimal(6, 3)
  /// Opción que el POS preselecciona. Solo una por grupo.
  isDefault         Boolean  @default(false)
  sortOrder         Int      @default(0)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  itemOptionGroup ItemOptionGroup    @relation(fields: [itemOptionGroupId], references: [id], onDelete: Cascade)
  value           OptionValue?       @relation(fields: [valueId], references: [id], onDelete: Cascade)
  effects         ItemOptionEffect[]
  orderOptions    OrderItemOption[]

  @@unique([itemOptionGroupId, valueId])
  @@index([itemOptionGroupId])
  @@index([valueId])
}

/// Efecto de una opción sobre la receta (solo recetas publicadas).
/// - REPLACE: cambia el insumo de un slot de la receta.
/// - ADD: añade consumo de inventario.
/// - REMOVE: quita un slot o un insumo.
model ItemOptionEffect {
  id                 String             @id @default(cuid())
  itemOptionValueId  String
  action             OptionEffectAction
  /// Slot de la receta a reemplazar o quitar (null en ADD).
  recipeIngredientId String?
  /// Insumo de la receta que se reemplaza (REPLACE) por `ingredientId`.
  replacesIngredientId String?
  /// Insumo que entra (REPLACE/ADD) o que se quita (REMOVE por insumo).
  ingredientId       String?
  quantity           Decimal?           @db.Decimal(12, 4)

  itemOptionValue  ItemOptionValue   @relation(fields: [itemOptionValueId], references: [id], onDelete: Cascade)
  recipeIngredient RecipeIngredient? @relation(fields: [recipeIngredientId], references: [id], onDelete: Cascade)
  replacesIngredient Ingredient?     @relation("OptionEffectReplacesIngredient", fields: [replacesIngredientId], references: [id], onDelete: Cascade)
  ingredient       Ingredient?       @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@index([itemOptionValueId])
  @@index([recipeIngredientId])
  @@index([replacesIngredientId])
  @@index([ingredientId])
}

/// Promoción de un combo (descuento por porcentaje, importe fijo o 2x1).
/// `daysOfWeek` vacío = todos los días; las horas son "HH:MM" locales.
model ComboPromotion {
  id         String        @id @default(cuid())
  itemId     String
  name       String
  type       PromotionType
  /// Porcentaje (0-100) o importe fijo en MXN. BOGO lo ignora.
  value      Decimal       @default(0) @db.Decimal(12, 2)
  startsAt   DateTime?
  endsAt     DateTime?
  daysOfWeek Int[]         @default([])
  startTime  String?
  endTime    String?
  isActive   Boolean       @default(true)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId, isActive])
}

// ============================================================================
// Menús (colecciones curadas de artículos para filtrar el POS)
// ============================================================================

/// Colección de artículos y combos, opcionalmente programada por día/horario.
/// No se vende ni tiene precio: solo organiza/filtra el catálogo del POS.
model Menu {
  id             String  @id @default(cuid())
  organizationId String?
  name           String
  description    String?
  isActive       Boolean @default(true)
  sortOrder      Int     @default(0)

  /// Vigencia recurrente. `daysOfWeek` vacío = todos los días.
  daysOfWeek Int[]   @default([])
  startTime  String? // "HH:MM" local
  endTime    String? // "HH:MM" local; admite cruce de medianoche

  /// Vigencia por fechas (opcional).
  startsAt DateTime?
  endsAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  items        MenuItem[]

  @@unique([organizationId, name])
  @@index([organizationId, isActive])
}

/// Artículo incluido en un menú, con su orden dentro de la colección.
model MenuItem {
  id        String @id @default(cuid())
  menuId    String
  itemId    String
  sortOrder Int    @default(0)

  menu Menu @relation(fields: [menuId], references: [id], onDelete: Cascade)
  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([menuId, itemId])
  @@index([menuId])
  @@index([itemId])
}

// ============================================================================
// Inventario y recetas
// ============================================================================

model Ingredient {
  id             String   @id @default(cuid())
  organizationId String?
  name           String
  sku            String? // Código interno / referencia proveedor
  /**
   * Unidad canónica de almacenamiento: siempre G, ML o UNIT.
   */
  baseUnit       UnitCode @default(UNIT)
  /**
   * Unidad con la que el usuario ve y captura las cantidades (misma dimensión).
   */
  displayUnit    UnitCode @default(UNIT)
  currentStock   Decimal  @default(0.0000) @db.Decimal(12, 4)
  minStock       Decimal  @default(0.0000) @db.Decimal(12, 4)
  maxStock       Decimal? @db.Decimal(12, 4) // Existencia máxima (opcional)
  unitCost       Decimal? @db.Decimal(12, 6) // Costo por unidad canónica
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  categoryId String?
  locationId String?

  organization        Organization?               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category            IngredientCategory?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  location            IngredientLocation?         @relation(fields: [locationId], references: [id], onDelete: SetNull)
  recipeIngredients   RecipeIngredient[]
  ingredientOptions   RecipeIngredientOption[]
  orderChoices        OrderItemIngredientChoice[]
  producedByRecipe    Recipe?                     @relation("RecipeProducedIngredient")
  inventoryMovements  InventoryMovement[]
  equivalences        IngredientEquivalence[]
  exclusions          ItemIngredientExclusion[]
  extraIngredients    ItemExtraIngredient[]
  orderItemExclusions OrderItemExclusion[]
  optionEffects       ItemOptionEffect[]
  optionEffectsReplacing ItemOptionEffect[] @relation("OptionEffectReplacesIngredient")
  branchStocks        BranchStock[]

  @@unique([organizationId, name])
  @@unique([organizationId, sku])
  @@index([organizationId, isActive])
  @@index([organizationId, categoryId])
  @@index([organizationId, locationId])
}

/// Equivalencia explícita entre dimensiones distintas para UN ingrediente
/// (ej. 1 taza de harina = 120 g). Nunca se deduce masa ↔ volumen.
/// Las unidades implicadas se normalizan a la canónica de su dimensión.
model IngredientCategory {
  id             String   @id @default(cuid())
  organizationId String?
  name           String
  description    String?
  isCore         Boolean  @default(false) // true = parte del core de la app, no editable
  isActive       Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ingredients  Ingredient[]

  @@unique([organizationId, name])
  @@index([organizationId, isActive])
}

model IngredientLocation {
  id             String   @id @default(cuid())
  organizationId String?
  name           String
  description    String?
  isCore         Boolean  @default(false) // true = parte del core de la app, no editable
  isActive       Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ingredients  Ingredient[]

  @@unique([organizationId, name])
  @@index([organizationId, isActive])
}

model IngredientEquivalence {
  id           String   @id @default(cuid())
  ingredientId String
  fromUnit     UnitCode
  toUnit       UnitCode
  factor       Decimal  @db.Decimal(12, 6) // 1 fromUnit = factor toUnit
  note         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@unique([ingredientId, fromUnit, toUnit])
  @@index([ingredientId])
}

/// Ingredientes que el cliente puede pedir sin incluir ("sin cebolla").
model ItemIngredientExclusion {
  id           String   @id @default(cuid())
  itemId       String   @map("productId")
  ingredientId String
  label        String?
  createdAt    DateTime @default(now())

  item       Item       @relation(fields: [itemId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@unique([itemId, ingredientId])
  @@index([itemId])
  @@index([ingredientId])
  @@map("ProductIngredientExclusion")
}

/// Componentes de un combo. No se permiten combos anidados (validación en API).
model ComboComponent {
  id                 String   @id @default(cuid())
  comboId            String
  componentItemId    String   @map("componentProductId")
  componentVariantId String?
  quantity           Int      @default(1)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  combo         Item         @relation("ComboComponents", fields: [comboId], references: [id], onDelete: Cascade)
  componentItem Item         @relation("ComboPartOf", fields: [componentItemId], references: [id], onDelete: Restrict)
  variant       ItemVariant? @relation(fields: [componentVariantId], references: [id], onDelete: Restrict)

  @@unique([comboId, componentItemId, componentVariantId])
  @@index([comboId])
  @@index([componentItemId])
}

/// Consumo de inventario de un extra (cantidad en la unidad canónica del ingrediente).
model ItemExtraIngredient {
  id           String  @id @default(cuid())
  itemExtraId  String  @map("productExtraId")
  ingredientId String
  quantity     Decimal @db.Decimal(12, 4)

  itemExtra  ItemExtra  @relation(fields: [itemExtraId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@unique([itemExtraId, ingredientId])
  @@index([ingredientId])
  @@map("ProductExtraIngredient")
}

model Recipe {
  id                   String    @id @default(cuid())
  organizationId       String?
  /// `null` = receta independiente (aún no publicada como artículo).
  itemId               String?   @map("productId")
  variantId            String? // null = receta base del artículo
  categoryId           String?
  name                 String
  description          String?
  /// Identidad del catálogo: la misma que el artículo publicado.
  catalogEntryId       String?
  /// Insumo que produce esta receta (ej. salsa verde). Único por receta.
  producesIngredientId String?   @unique
  yieldQuantity        Decimal?  @db.Decimal(12, 4)
  yieldUnit            UnitCode?
  isActive             Boolean   @default(true)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  organization       Organization?      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  item               Item?              @relation(fields: [itemId], references: [id], onDelete: Cascade)
  variant            ItemVariant?       @relation(fields: [variantId], references: [id], onDelete: Cascade)
  catalogEntry       CatalogEntry?      @relation(fields: [catalogEntryId], references: [id], onDelete: SetNull)
  category           Category?          @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  producesIngredient Ingredient?        @relation("RecipeProducedIngredient", fields: [producesIngredientId], references: [id], onDelete: SetNull)
  ingredients        RecipeIngredient[]

  @@unique([itemId, variantId])
  @@index([organizationId])
  @@index([variantId])
  @@index([categoryId])
  @@index([catalogEntryId])
}

model RecipeIngredient {
  id           String  @id @default(cuid())
  recipeId     String
  /// Insumo default del slot (puede cambiarse al pedir entre las alternativas).
  ingredientId String
  /// `null` = común a todas las presentaciones; si no, solo a esa.
  variantId    String?
  /// Nombre del slot (ej. "Leche"); si falta se usa el nombre del insumo.
  label        String?
  quantity     Decimal @db.Decimal(12, 4) // Cantidad en la unidad canónica del ingrediente
  isOptional   Boolean @default(false)
  sortOrder    Int     @default(0)

  recipe        Recipe                      @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredient    Ingredient                  @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  variant       ItemVariant?                @relation(fields: [variantId], references: [id], onDelete: Cascade)
  options       RecipeIngredientOption[]
  orderChoices  OrderItemIngredientChoice[]
  optionEffects ItemOptionEffect[]

  @@index([recipeId, variantId])
  @@index([ingredientId])
  @@index([variantId])
}

/// Alternativa de un ingrediente de receta (ej. leche deslactosada o de coco).
/// Cada alternativa guarda su propia cantidad en la unidad canónica de su insumo.
model RecipeIngredientOption {
  id                 String  @id @default(cuid())
  recipeIngredientId String
  ingredientId       String
  quantity           Decimal @db.Decimal(12, 4)
  sortOrder          Int     @default(0)

  recipeIngredient RecipeIngredient @relation(fields: [recipeIngredientId], references: [id], onDelete: Cascade)
  ingredient       Ingredient       @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@unique([recipeIngredientId, ingredientId])
  @@index([recipeIngredientId])
  @@index([ingredientId])
}

/// Opción elegida al vender una línea (soporte para cambiar el default en pedidos).
model OrderItemIngredientChoice {
  id                 String @id @default(cuid())
  orderItemId        String
  recipeIngredientId String
  ingredientId       String

  orderItem        OrderItem        @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  recipeIngredient RecipeIngredient @relation(fields: [recipeIngredientId], references: [id], onDelete: Cascade)
  ingredient       Ingredient       @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@unique([orderItemId, recipeIngredientId])
  @@index([recipeIngredientId])
  @@index([ingredientId])
}

model InventoryMovement {
  id             String                @id @default(cuid())
  organizationId String
  branchId       String?
  /// `null` si el producto se eliminó; el kardex se conserva.
  ingredientId   String?
  /// Nombre del producto en el momento del movimiento (snapshot).
  ingredientName String
  /// Unidad visible del producto en el momento del movimiento.
  displayUnit    UnitCode
  userId         String?
  type           InventoryMovementType
  quantity       Decimal               @db.Decimal(12, 4) // Positivo = entrada, Negativo = salida
  stockAfter     Decimal?              @db.Decimal(12, 4) // Saldo resultante (kardex auditable)
  reason         String?
  referenceId    String? // ID de orden, ronda, etc.
  referenceType  String? // "ORDER_ROUND", "ADJUSTMENT", etc.
  dedupeKey      String?               @unique // idempotencia de consumos
  createdAt      DateTime              @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  // `SetNull`: el kardex se conserva aunque se elimine el producto.
  ingredient   Ingredient?  @relation(fields: [ingredientId], references: [id], onDelete: SetNull)
  // `SetNull`: el kardex se conserva aunque se elimine la cuenta del autor.
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([branchId, createdAt])
  @@index([ingredientId])
  @@index([userId])
}

// ============================================================================
// Pedidos y cocina
// ============================================================================

model Order {
  id             String      @id @default(cuid())
  organizationId String?
  branchId       String?
  tableNumber    String?
  isTakeaway     Boolean     @default(false)
  status         OrderStatus @default(OPEN)
  subtotal       Decimal     @default(0.0000) @db.Decimal(12, 2)
  taxTotal       Decimal     @default(0.0000) @db.Decimal(12, 2)
  total          Decimal     @default(0.0000) @db.Decimal(12, 2)
  idempotencyKey String?     @unique
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  // `SetNull`: al eliminar la cuenta del usuario el pedido se conserva sin autor.
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId       String?
  rounds       OrderRound[]
  payments     Payment[]

  @@index([organizationId, status, createdAt])
  @@index([branchId, status, createdAt])
}

model OrderRound {
  id             String           @id @default(cuid())
  orderId        String
  status         OrderRoundStatus @default(PENDING)
  idempotencyKey String?          @unique
  sentAt         DateTime?
  startedAt      DateTime?
  readyAt        DateTime?
  deliveredAt    DateTime?
  cancelledAt    DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  order         Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  items         OrderItem[]
  statusHistory OrderStatusHistory[]

  @@index([orderId])
  @@index([status, createdAt])
}

model OrderItem {
  id             String   @id @default(cuid())
  orderRoundId   String
  itemId         String   @map("productId")
  itemVariantId  String?  @map("productVariantId")
  // Copia histórica del catálogo al momento del pedido
  itemName       String   @map("productName")
  variantName    String?
  itemPrice      Decimal  @map("productPrice") @db.Decimal(12, 2)
  taxRate        Decimal? @db.Decimal(5, 4)
  taxAmount      Decimal  @default(0) @db.Decimal(12, 2)
  quantity       Int      @default(1)
  notes          String?
  subtotal       Decimal  @db.Decimal(12, 2)
  /// Descuento aplicado por una promoción del combo (no altera `itemPrice`).
  discountAmount Decimal  @default(0) @db.Decimal(12, 2)

  orderRound        OrderRound                  @relation(fields: [orderRoundId], references: [id], onDelete: Cascade)
  item              Item                        @relation("OrderItemRef", fields: [itemId], references: [id], onDelete: Restrict)
  variant           ItemVariant?                @relation(fields: [itemVariantId], references: [id])
  extras            OrderItemExtra[]
  exclusions        OrderItemExclusion[]
  options           OrderItemOption[]
  ingredientChoices OrderItemIngredientChoice[]

  @@index([orderRoundId])
  @@index([itemId])
}

model OrderItemExtra {
  id          String  @id @default(cuid())
  orderItemId String
  itemExtraId String? @map("productExtraId")
  extraName   String
  extraPrice  Decimal @db.Decimal(12, 2)

  orderItem OrderItem  @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  itemExtra ItemExtra? @relation(fields: [itemExtraId], references: [id])

  @@index([orderItemId])
}

/// Opción elegida en una línea, con snapshot para cocina, ticket y reportes.
model OrderItemOption {
  id                String  @id @default(cuid())
  orderItemId       String
  itemOptionValueId String?
  groupName         String
  optionName        String
  kitchenLabel      String?
  priceDelta        Decimal @default(0) @db.Decimal(12, 2)

  orderItem       OrderItem        @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  itemOptionValue ItemOptionValue? @relation(fields: [itemOptionValueId], references: [id], onDelete: SetNull)

  @@index([orderItemId])
  @@index([itemOptionValueId])
}

/// Ingredientes que el cliente pidió quitar. Se descuentan de la receta al
/// consumir inventario, para que el descuento coincida con lo servido.
model OrderItemExclusion {
  id           String @id @default(cuid())
  orderItemId  String
  ingredientId String

  orderItem  OrderItem  @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@unique([orderItemId, ingredientId])
  @@index([ingredientId])
}

model OrderStatusHistory {
  id             String   @id @default(cuid())
  orderRoundId   String
  previousStatus String?
  newStatus      String
  changedById    String?
  changedAt      DateTime @default(now())
  reason         String?

  orderRound OrderRound @relation(fields: [orderRoundId], references: [id], onDelete: Cascade)
  // `SetNull`: la traza de estados se conserva sin autor si se borra la cuenta.
  changedBy  User?      @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@index([orderRoundId])
  @@index([changedAt])
}

// ============================================================================
// Pagos y auditoría
// ============================================================================

model Payment {
  id             String        @id @default(cuid())
  organizationId String?
  branchId       String?
  orderId        String
  userId         String?
  method         PaymentMethod
  amount         Decimal       @db.Decimal(12, 2)
  status         PaymentStatus @default(PENDING)
  paidAt         DateTime?
  confirmedAt    DateTime?
  confirmedById  String?
  idempotencyKey String?       @unique
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  order        Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  // `SetNull`: el pago sobrevive al borrado de la cuenta que lo registró.
  user         User?         @relation("PaymentUser", fields: [userId], references: [id], onDelete: SetNull)
  confirmedBy  User?         @relation("PaymentConfirmedBy", fields: [confirmedById], references: [id], onDelete: SetNull)

  @@index([organizationId, status, createdAt])
  @@index([branchId, createdAt])
  @@index([orderId])
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String?
  userId         String?
  action         String
  entity         String
  entityId       String?
  oldValues      Json?
  newValues      Json?
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // `SetNull`: la auditoría se conserva aunque la cuenta ya no exista.
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([userId])
  @@index([entity, entityId])
}

// ============================================================================
// Anal�tica de uso (eventos append-only para reportes y modelos predictivos)
// ============================================================================

/// Evento de uso del sistema (opciones, ventas, men�s, POS...).
///
/// Sin claves for�neas a prop�sito: el hist�rico debe sobrevivir al borrado o
/// renombrado de grupos, art�culos, men�s y pedidos. Los nombres se guardan
/// como snapshot (`subjectName` y `metadata`) para que los reportes no cambien.
model AnalyticsEvent {
  id             String   @id @default(cuid())
  organizationId String?
  branchId       String?
  userId         String?
  /// Nombre del evento, p. ej. "option_group.selected".
  name           String
  /// Entidad protagonista: "optionGroup", "optionValue", "item", "menu", "order".
  subjectType    String?
  subjectId      String?
  /// Snapshot del nombre de la entidad protagonista.
  subjectName    String?
  itemId         String?
  orderId        String?
  menuId         String?
  quantity       Decimal  @default(0) @db.Decimal(12, 4)
  amount         Decimal  @default(0) @db.Decimal(12, 2)
  /// Datos libres del evento (valor elegido, posici�n, etc.).
  metadata       Json?
  occurredAt     DateTime @default(now())

  @@index([organizationId, name, occurredAt])
  @@index([subjectType, subjectId, occurredAt])
  @@index([itemId, occurredAt])
  @@index([menuId, occurredAt])
  @@index([orderId])
  @@index([occurredAt])
}
