# Naranja Pimienta — API variables de entorno (ejemplo, sin secretos reales)

NODE_ENV=development
PORT=3001

# Base de datos PostgreSQL (Docker Desktop, puerto 55432 en el host)
DATABASE_URL="postgresql://np_user:np_password@localhost:55432/np_db?schema=public"

# Origen del frontend (para CORS y cookies)
WEB_ORIGIN="http://localhost:3000"

# Origen público de la API (se acepta como Origin válido para Swagger y CSRF)
API_PUBLIC_ORIGIN="http://localhost:3001"

# Cookies (ajustar según despliegue)
COOKIE_DOMAIN=

# JWT secretos (cambiar en producción, nunca subir valores reales al repositorio)
JWT_ACCESS_SECRET="cambiar-en-produccion"
JWT_REFRESH_SECRET="cambiar-en-produccion"

# Basic auth de la documentación (Swagger en /docs*). En producción son
# obligatorias: el arranque falla si faltan. En desarrollo, si se dejan vacías,
# /docs queda accesible sin credenciales.
SWAGGER_USER=
SWAGGER_PASSWORD=

# Correo (Resend). En desarrollo, si el remitente no es un dominio verificado,
# los correos se guardan en api/.mail-outbox/mails.jsonl y no se llama a Resend.
RESEND_API_KEY=
RESEND_FROM_EMAIL="no-reply@naranjapimienta.local"

# Cloudflare R2 para imágenes (bucket público `sazona-public`).
# El navegador sube el original a `{org}/tmp/` con una URL firmada (PUT) y luego
# llama a `finalize`: la API lo descarga, genera AVIF (calidad 70) + JPEG en
# 640 y 1280 px, guarda solo esas variantes y borra el original. En el bucket
# nunca queda la imagen tal como se subió.
# Estructura final:
#   {org}/{página}/{id}/{hash}-{ancho}x{alto}-{640|1280}.{avif|jpg}
#   {org}/catalog/{entryId}/variants/{variantId}/...   (presentación)
# Los objetos llevan hash y `Cache-Control: immutable`, así que nunca se
# reescriben. Una regla de ciclo de vida sobre `{org}/tmp/` debe borrar lo que
# quede de subidas abandonadas (recomendado: 1 día).
# CORS del bucket: AllowedOrigins = WEB_ORIGIN, AllowedMethods = GET, PUT, HEAD
# y AllowedHeaders = Content-Type (el navegador hace preflight del PUT).
# R2 todavía no soporta presigned POST: no cambiar la subida a POST.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET="sazona-public"
# Dominio público del bucket, sin barra final. En producción usa un dominio
# propio proxeado por Cloudflare (p. ej. https://img.ejemplo.com) y una Cache
# Rule "Cache Everything": el dominio `*.r2.dev` no cachea en el borde y está
# limitado, así que cada visita acabaría siendo una operación Clase B.
R2_PUBLIC_BASE_URL=
# Opcional: endpoint S3 alternativo (por defecto se deriva de R2_ACCOUNT_ID)
R2_ENDPOINT=
# Tamaño máximo por imagen en bytes (5 MB)
R2_MAX_UPLOAD_BYTES=5242880

# Google OAuth (opcional). Si se configuran ambas, se habilita /v1/auth/google.
# La redirect URI debe coincidir exactamente con la registrada en Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Por defecto: ${API_PUBLIC_ORIGIN}/v1/auth/google/callback
GOOGLE_REDIRECT_URI=

# Mercado Pago Point (opcional). Si se configura cualquier variable del bloque,
# deben estar todas. Se obtienen en "Tus integraciones" de Mercado Pago.
# MP_REDIRECT_URI debe coincidir exactamente con la registrada en la aplicación:
#   ${API_PUBLIC_ORIGIN}/v1/mercadopago/callback
# MP_TOKEN_ENCRYPTION_KEY: clave de 32 bytes en base64. Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MP_CLIENT_ID=
MP_CLIENT_SECRET=
MP_REDIRECT_URI=
MP_WEBHOOK_SECRET=
MP_TOKEN_ENCRYPTION_KEY=
# Opcionales: identificadores que Mercado Pago asigna a la plataforma/integrador.
MP_PLATFORM_ID=
MP_INTEGRATOR_ID=
MP_SPONSOR_ID=
