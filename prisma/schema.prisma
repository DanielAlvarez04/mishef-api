// Naranja Pimienta — Esquema de base de datos (PostgreSQL 16)
// Prisma 7
//
// Notas de diseño:
// - `Membership` es la única fuente de verdad de la pertenencia usuario ↔ organización.
// - Un usuario puede tener varios roles dentro de una organización (`Membership.roles`).
// - La tasa de IVA es un ajuste del negocio (`Organization.taxRate`, 16 % por defecto) y
//   se aplica a los productos que no tengan una tasa propia (`Product.taxRate`).
// - Los precios del catálogo son precios finales con IVA incluido (`plan.md` §6.9).
// - Los estados son enums para que la base de datos rechace valores inválidos.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// Enums
// ============================================================================

enum Role {
  ADMIN
  WAITER
  KITCHEN
  CASHIER
  INVENTORY_MANAGER
}

enum OrderStatus {
  OPEN
  CLOSED
  CANCELLED
}

enum OrderRoundStatus {
  PENDING
  HELD
  FIRED
  PREPARING
  READY
  PICKED_UP
  DELIVERED
  CANCELLED
}

enum KitchenMode {
  GENERAL
  ADVANCED
}

enum KitchenStationType {
  GARDE_MANGER
  ENTREMETIER
  SAUCIER
  GRILL
  FRY
  FISH
  PASTRY
  BUTCHERY
  EXPO
  CUSTOM
}

enum KitchenPositionLevel {
  MANAGEMENT
  CHEF_DE_PARTIE
  COOK
  ASSISTANT
  EXPO
}

enum KitchenTicketStatus {
  PENDING
  PREPARING
  READY
  PICKED_UP
  DELIVERED
  CANCELLED
}

enum KitchenItemStatus {
  PENDING
  PREPARING
  READY
  PICKED_UP
  DELIVERED
  VOID
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  /// Cobro enviado a una terminal Mercado Pago Point.
  MERCADO_PAGO_POINT
  /// Link de pago hospedado por Mercado Pago (Checkout Pro).
  MERCADO_PAGO_LINK
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  REFUNDED
}

/// Canal de venta de la cuenta.
enum OrderChannel {
  DINE_IN
  COUNTER
  PHONE
  DELIVERY
}

/// Tratamiento demográfico del comensal (dato para estadísticas).
enum GuestTitle {
  NINO
  NINA
  JOVEN
  SENORITA
  SENOR
  SENORA
  SENOR_MAYOR
  SENORA_MAYOR
}

/// Sexo declarado del cliente (opcional, se usa para el servicio).
enum GuestSex {
  MASCULINO
  FEMENINO
  LGBT
}

/// Rango de edad del cliente (opcional, se usa para el servicio).
enum GuestAgeRange {
  NINO
  JOVEN
  ADULTO
  ADULTO_MAYOR
}

/// Cómo se dividió una cuenta para cobrarla.
enum SplitMode {
  BY_GUEST
  EQUAL
  CUSTOM
}

/// Estado de una parte de la cuenta.
enum SplitStatus {
  OPEN
  PAID
  CANCELLED
}

/// Origen del porcentaje de propina registrado.
enum TipSource {
  NONE
  SUGGESTED
  CUSTOM
  CUSTOMER_DISPLAY
  /// Propina capturada por la terminal Point (no la elige la app).
  TERMINAL
}

enum CashSessionStatus {
  OPEN
  CLOSED
}

enum CashMovementType {
  WITHDRAWAL
  DEPOSIT
  EXPENSE
  ADJUSTMENT
}

enum InventoryMovementType {
  ADJUSTMENT
  CONSUMPTION
  RETURN
  PRODUCTION
}

enum TwoFactorPurpose {
  LOGIN
  ENABLE
}

/// Unidad de medida. La dimensión y el factor a la unidad base viven en código
/// (`src/common/units.ts`): masa (base g), volumen (base ml) y conteo (base
/// pieza = UNIT). El catálogo es fijo: no se edita desde la aplicación.
enum UnitCode {
  MG
  G
  KG
  OZ
  LB
  ML
  L
  TSP
  TBSP
  CUP
  FL_OZ
  GAL
  UNIT
  HALF_PIECE
  PAIR
  HALF_DOZEN
  DOZEN
}

/// Tipo de categoría: agrupa artículos vendibles o recetas/preparaciones.
enum CategoryKind {
  ARTICLE
  RECIPE
}

/// Cómo se elige dentro de un grupo de opciones.
enum OptionSelection {
  SINGLE
  MULTIPLE
}

/// Efecto de una opción sobre la receta de un artículo.
enum OptionEffectAction {
  ADD
  REPLACE
  REMOVE
}

/// Tipo de promoción configurable de un combo.
enum PromotionType {
  PERCENT
  FIXED
  BOGO
  PAY_X_GET_Y
  SPECIAL_PRICE
  FREE_ITEM
  SECOND_HALF_PRICE
}

/// Origen del tiempo base de preparación en cocina.
enum PrepTimeSource {
  MANUAL
  HISTORICAL
}

// ============================================================================
// Identidad y organización
// ============================================================================

model Organization {
  id                  String      @id @default(cuid())
  name                String
  slug                String      @unique
  domain              String?     @unique // dominio personalizado del negocio (ej. app.micafeteria.com)
  /// Token que el negocio publica en `_mishef.<domain>` para demostrar control.
  domainToken         String?
  /// `null` mientras el dominio no esté verificado.
  domainVerifiedAt    DateTime?
  /// Id del custom hostname en Cloudflare for SaaS.
  domainProviderId    String?
  /// El plan contratado incluye dominio propio.
  customDomainEnabled Boolean     @default(false)
  /// Cuántas veces el negocio cambió su dirección (máximo 1).
  slugChanges         Int         @default(0)
  /// Bytes ocupados en R2 (imágenes optimizadas y fotos de merma).
  storageBytes        BigInt      @default(0)
  slugAliases         SlugAlias[]
  taxRate             Decimal     @default(0.16) @db.Decimal(5, 4) // IVA por defecto del negocio (0.16 = 16 %)
  /// Código ISO 4217 de la moneda del negocio (ver `src/common/currency.ts`).
  currency            String      @default("MXN")
  /// Color primario de la marca en formato `#rrggbb`. `null` = tema por defecto.
  brandColor          String?
  /// Tema visual del panel (clases `data-theme` / `theme-*` en globals.css).
  theme               String      @default("default")
  /// URL pública del logo (R2). `null` = icono genérico.
  logoUrl             String?
  /// Clave base de la imagen optimizada del logo en R2.
  logoKey             String?
  /// JPEG pequeño (384 px) que se imprime en la terminal Point.
  logoReceiptKey      String?
  /// Dirección escrita del negocio (para el ticket y el menú público).
  address             String?
  /// Coordenadas del negocio. Sirven para el mapa y las funciones por cercanía.
  latitude            Decimal?    @db.Decimal(10, 7)
  longitude           Decimal?    @db.Decimal(10, 7)
  isActive            Boolean     @default(true)
  /// Modo práctica: no se registra analítica de operación mientras esté activo.
  practiceMode        Boolean     @default(false)
  /// Fin automático del modo práctica (48 h desde el alta). `null` = manual.
  practiceUntil       DateTime?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  // Onboarding fields
  businessType                String? // Giro principal: restaurante, cafetería, etc.
  serviceTypes                String[] @default([]) // Modelo de servicio: mesa, mostrador, etc.
  goals                       String[] @default([]) // Objetivos: inventario, costos, etc.
  hasBranches                 Boolean  @default(false) // "Tengo sucursales"
  /// Mostrar/activar la sección de insumos core sugeridos en Configuración.
  useCoreSuggestions          Boolean  @default(true)
  /// Mostrar/activar los grupos de opciones core sugeridos en el editor de artículos.
  useCoreOptionGroups         Boolean  @default(true)
  /// Mostrar/activar las categorías core de artículos sugeridas.
  useCoreCategories           Boolean  @default(true)
  /// Mostrar/activar las categorías core de recetas sugeridas.
  useCoreRecipeCategories     Boolean  @default(true)
  /// Mostrar/activar las categorías core de insumos sugeridas.
  useCoreIngredientCategories Boolean  @default(true)

  // Cocina
  /// Tiempo de preparación manual por defecto, en minutos.
  kitchenPrepMinutes  Int            @default(15)
  /// De dónde sale el tiempo base: manual o promedio histórico real.
  kitchenPrepSource   PrepTimeSource @default(MANUAL)
  /// Priorizar la cola de cocina por urgencia en lugar de llegada.
  kitchenSuggestOrder Boolean        @default(true)

  // Asistencia
  /// Aplicar tolerancias al registrar checadas (si es false, se guarda la hora exacta).
  attendanceApplyTolerance         Boolean @default(true)
  /// Minutos de gracia para una entrada tardía.
  attendanceLateGraceMinutes       Int     @default(10)
  /// Minutos de gracia para la comida/descanso.
  attendanceLunchGraceMinutes      Int     @default(5)
  /// Minutos de gracia para una salida anticipada.
  attendanceEarlyLeaveGraceMinutes Int     @default(15)
  /// Duración de comida por defecto cuando el horario no la define.
  attendanceDefaultBreakMinutes    Int     @default(60)

  /// Correo para facturación de la suscripción de la plataforma.
  billingEmail String?

  /// Overrides de funciones por organización: `{ "inventory": false }`.
  /// Los defaults viven en `src/common/features.ts`.
  featureOverrides Json @default("{}")

  memberships          Membership[]
  branches             Branch[]
  orders               Order[]
  payments             Payment[]
  inventoryMovements   InventoryMovement[]
  wastes               Waste[]
  auditLogs            AuditLog[]
  categories           Category[]
  categoryOverrides    CategoryOverride[]
  items                Item[]
  ingredients          Ingredient[]
  recipes              Recipe[]
  catalogEntries       CatalogEntry[]
  ingredientCategories IngredientCategory[]
  ingredientLocations  IngredientLocation[]
  optionGroups         OptionGroup[]
  menus                Menu[]
  mediaAssets          MediaAsset[]
  kitchenStations      KitchenStation[]
  kitchenPositions     KitchenPosition[]
  kitchenCourses       KitchenCourse[]

  mercadoPagoConnection MercadoPagoConnection?
  mercadoPagoTerminals  MercadoPagoTerminal[]
  subscription          OrganizationSubscription?
  fiscalProfile         FiscalProfile?

  cashSessions          CashSession[]
  cashMovements         CashMovement[]
  posDevices            PosDevice[]
  posPairings           PosPairing[]
  posDisplays           PosDisplay[]
  imageJobs             ImageJob[]
  invitations           Invitation[]
  shifts                Shift[]
  shiftTemplates        ShiftTemplate[]
  schedules             Schedule[]
  attendanceEvents      AttendanceEvent[]
  attendanceAdjustments AttendanceAdjustment[]
}

/// Configuración global de la plataforma. El valor es JSON validado por el
/// servicio que lo usa; por ejemplo, la plantilla global del ticket.
model PlatformSetting {
  key         String   @id
  value       Json
  updatedById String?
  updatedAt   DateTime @updatedAt
}

model User {
  id                     String    @id @default(cuid())
  email                  String?   @unique
  /// Campo legado solo para mostrar en reportes. El login vive en `Membership.username`.
  username               String?
  passwordHash           String?
  name                   String?
  googleId               String?   @unique // `sub` de Google (OpenID Connect)
  isActive               Boolean   @default(true)
  emailVerified          Boolean   @default(false)
  twoFactorEnabled       Boolean   @default(false)
  /// Secreto TOTP (app autenticadora), solo si `twoFactorTotpEnabled`.
  twoFactorTotpSecret    String?
  twoFactorTotpEnabled   Boolean   @default(false)
  /// Códigos de recuperación hasheados (se muestran una sola vez al activar 2FA).
  twoFactorRecoveryCodes String[]  @default([])
  /// El usuario debe cambiar la contraseña inicial en su primer acceso.
  mustChangePassword     Boolean   @default(false)
  /// Metadatos del último inicio de sesión para alertar de uno nuevo.
  lastLoginAt            DateTime?
  lastLoginIp            String?
  lastLoginUserAgent     String?
  /// Acceso al panel de plataforma (`/platform`, `/plans`, `/subscriptions`).
  isPlatformAdmin        Boolean   @default(false)
  onboardedAt            DateTime? // null hasta completar el onboarding
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  memberships                   Membership[]
  authSessions                  AuthSession[]
  twoFactorCodes                TwoFactorCode[]
  orders                        Order[]
  payments                      Payment[]               @relation("PaymentUser")
  confirmedPayments             Payment[]               @relation("PaymentConfirmedBy")
  inventoryMovements            InventoryMovement[]
  auditLogs                     AuditLog[]
  emailVerificationToken        EmailVerificationToken?
  passwordResetToken            PasswordResetToken?
  orderStatusHistories          OrderStatusHistory[]
  tipPayments                   Payment[]               @relation("PaymentTipRecipient")
  cashSessionsOpened            CashSession[]           @relation("CashSessionOpenedBy")
  cashSessionsClosed            CashSession[]           @relation("CashSessionClosedBy")
  cashMovements                 CashMovement[]
  posDevicesPaired              PosDevice[]             @relation("PosDevicePairedBy")
  posPairingsCreated            PosPairing[]            @relation("PosPairingCreatedBy")
  posDisplaysCreated            PosDisplay[]            @relation("PosDisplayCreatedBy")
  shifts                        Shift[]
  shiftsRecorded                Shift[]                 @relation("ShiftRecordedBy")
  shiftsReviewed                Shift[]                 @relation("ShiftReviewedBy")
  attendanceEventsRecorded      AttendanceEvent[]       @relation("AttendanceEventRecordedBy")
  attendanceAdjustments         AttendanceAdjustment[]  @relation("AttendanceAdjustmentCreatedBy")
  attendanceAdjustmentsReceived AttendanceAdjustment[]  @relation("AttendanceAdjustmentUser")
  attendanceEvents              AttendanceEvent[]
  scheduleEntries               ScheduleEntry[]
  wastes                        Waste[]

  @@index([isActive])
  @@index([username])
}

model Membership {
  id                     String    @id @default(cuid())
  userId                 String
  organizationId         String?
  branchId               String? // null = acceso a todas las sucursales
  /// Nombre de usuario local del negocio (minúsculas). Único por organización.
  username               String?
  roles                  Role[]    @default([WAITER])
  kitchenPositionId      String?
  isActive               Boolean   @default(true)
  /// Creador del negocio; puede iniciar sesión desde el dominio principal.
  isOwner                Boolean   @default(false)
  /// PIN de 4-8 dígitos para entrar a la caja en un dispositivo vinculado.
  pinHash                String?
  pinUpdatedAt           DateTime?
  pinAttempts            Int       @default(0)
  pinLockedUntil         DateTime?
  /// Puede operar el modo checador y registrar checadas de otros con su PIN.
  attendanceKioskEnabled Boolean   @default(false)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  user                   User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization           Organization?       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch                 Branch?             @relation(fields: [branchId], references: [id], onDelete: SetNull)
  kitchenPosition        KitchenPosition?    @relation(fields: [kitchenPositionId], references: [id], onDelete: SetNull)
  kitchenAssignments     KitchenAssignment[]
  assignedKitchenTickets KitchenTicket[]     @relation("KitchenTicketAssignee")

  @@unique([userId, organizationId])
  @@unique([organizationId, username])
  @@index([username])
  @@index([organizationId])
  @@index([branchId])
}

/// Sucursal física del negocio. Por ahora agrupa al personal; el inventario y
/// los pedidos se irán vinculando por fases para no mezclar existencias.
model Branch {
  id                   String      @id @default(cuid())
  organizationId       String
  name                 String
  address              String?
  phone                String?
  isActive             Boolean     @default(true)
  /// Modo de cocina de la sucursal. No hay modo a nivel organización.
  kitchenMode          KitchenMode @default(GENERAL)
  /// Porcentaje de propina sugerido en el POS (0 = sin sugerencia).
  defaultTipPercent    Int         @default(0)
  /// Plantilla del ticket de la sucursal. `null` = plantilla por defecto.
  receiptTemplate      Json?
  /// Coordenadas del local para la geocerca del checador.
  latitude             Decimal?    @db.Decimal(10, 7)
  longitude            Decimal?    @db.Decimal(10, 7)
  geofenceRadiusMeters Int         @default(150)
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships  Membership[]
  stock        BranchStock[]
  movements    InventoryMovement[]
  wastes       Waste[]
  orders       Order[]
  payments     Payment[]

  mercadoPagoTerminals  MercadoPagoTerminal[]
  cashSessions          CashSession[]
  cashMovements         CashMovement[]
  dailySequences        BranchDailySequence[]
  posDevices            PosDevice[]
  posPairings           PosPairing[]
  posDisplays           PosDisplay[]
  shifts                Shift[]
  schedules             Schedule[]
  attendanceEvents      AttendanceEvent[]
  attendanceAdjustments AttendanceAdjustment[]
  kitchenStations       KitchenStation[]

  @@unique([organizationId, name])
  @@index([organizationId, isActive])
}

/// Existencia de un ingrediente en una sucursal concreta.
///
/// `Ingredient.currentStock` sigue siendo el total de la organización; este
/// registro permite operar cada local por separado sin perder el consolidado.
model BranchStock {
  id           String   @id @default(cuid())
  branchId     String
  ingredientId String
  quantity     Decimal  @default(0.0000) @db.Decimal(12, 4)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  branch     Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@unique([branchId, ingredientId])
  @@index([ingredientId])
}

model AuthSession {
  id                  String    @id @default(cuid())
  userId              String
  refreshTokenHash    String    @unique
  expiresAt           DateTime // expiración del refresh token actual
  absoluteExpiresAt   DateTime // expiración absoluta de la sesión (límite de rotación)
  revokedAt           DateTime?
  revokedReason       String? // "LOGOUT", "ROTATED", "REUSE_DETECTED", "PASSWORD_CHANGED"
  replacedBySessionId String?
  /// Usuario de plataforma que abrió esta sesión de soporte (solo lectura).
  impersonatedById    String?
  userAgent           String?
  ip                  String?
  lastUsedAt          DateTime?
  createdAt           DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([impersonatedById])
  @@index([expiresAt])
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String    @unique
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TwoFactorCode {
  id             String           @id
  userId         String
  /// Negocio de la sesión que se está autenticando (solo en LOGIN).
  organizationId String?
  purpose        TwoFactorPurpose
  codeHash       String
  expiresAt      DateTime
  attempts       Int              @default(0)
  consumedAt     DateTime?
  createdAt      DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, createdAt])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String    @unique
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============================================================================
// Catálogo
// ============================================================================

model Category {
  id             String       @id @default(cuid())
  organizationId String?
  /// Identificador estable de las categorías core (breakfast, sauces, …).
  code           String?
  name           String
  description    String?
  /// Color de la categoría en el catálogo y el POS (`red-400`, `sky-600`, …).
  color          String?
  isCore         Boolean      @default(false) // true = parte del core, no editable
  kind           CategoryKind @default(ARTICLE)
  isActive       Boolean      @default(true)
  sortOrder      Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization?        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  items        Item[]
  recipes      Recipe[]
  overrides    CategoryOverride[]
  stationRules KitchenStationRule[] @relation("CategoryStationRule")

  @@unique([organizationId, kind, name])
  @@unique([kind, code])
  @@index([organizationId])
  @@index([kind, isCore])
}

/// Personalización por negocio de una categoría core (nombre global, lo demás propio).
model CategoryOverride {
  id             String   @id @default(cuid())
  organizationId String
  categoryId     String
  /// `null` = hereda la descripción core; `""` = el negocio la dejó vacía.
  description    String?
  color          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category     Category     @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([organizationId, categoryId])
  @@index([organizationId])
}

/// Identidad global de un elemento del catálogo (artículo, receta o ambos).
///
/// Su `id` es la carpeta estable en R2: `{organización}/catalog/{id}/`.
/// La comparten la receta y el artículo que la publica, así que la ruta de la
/// imagen no cambia al publicar ni al despublicar y nunca hay dos objetos.
model CatalogEntry {
  id             String   @id @default(cuid())
  organizationId String?
  imageKey       String? // Prefijo del objeto en R2; las URLs se derivan
  imageUrl       String?
  /// Variantes optimizadas (AVIF + JPEG por ancho) con sus URLs públicas.
  imageVariants  Json?
  /// Nombre normalizado y legible de la imagen (sin guiones ni extensión).
  imageName      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  items        Item[]
  recipes      Recipe[]

  @@index([organizationId])
}

enum MediaKind {
  IMAGE
  VIDEO
}

/// Galería adicional por entidad (artículos, recetas, insumos y menús).
model MediaAsset {
  id             String    @id @default(cuid())
  organizationId String
  /// ITEM | RECIPE | INGREDIENT | MENU
  entityType     String
  entityId       String
  kind           MediaKind
  key            String    @unique
  url            String
  name           String?
  mimeType       String?
  sizeBytes      BigInt?
  sortOrder      Int       @default(0)
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, entityType, entityId])
}

/// Datos fiscales del negocio para CFDI.
///
/// Fase 0: solo captura y validación. No hay timbrado ni CSD todavía; el
/// emisor y el PAC se definen en `docs/facturacion-cfdi.md`.
model FiscalProfile {
  id             String   @id @default(cuid())
  organizationId String   @unique
  rfc            String
  legalName      String
  /// Clave del catálogo SAT (601, 603, 605…).
  taxRegime      String
  zipCode        String   @db.VarChar(5)
  /// Uso del CFDI; `G03` (gastos en general) por defecto.
  cfdiUse        String   @default("G03")
  email          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

/// Artículo del catálogo (lo que se vende en el POS).
/// La tabla sigue llamándose `Product` para no migrar la base.
model Item {
  id               String   @id @default(cuid())
  organizationId   String?
  categoryId       String?
  /// Identidad del catálogo: dueña de la imagen y de la carpeta en R2.
  catalogEntryId   String?  @unique
  name             String
  description      String?
  sku              String? // Código interno / importación CSV
  price            Decimal  @db.Decimal(12, 2) // Precio final con IVA incluido
  taxRate          Decimal? @db.Decimal(5, 4) // Tasa aplicable; null = no configurada (no se asume ninguna)
  /// Estación primaria de cocina para el modo Avanzado.
  defaultStationId String?
  isActive         Boolean  @default(true)
  /// Marcado manual desde el catálogo: el menú público lo muestra como agotado.
  isSoldOut        Boolean  @default(false)
  /// La receta dejó de publicarse como artículo: se oculta del catálogo de
  /// artículos (aunque esté inactivo) y se conserva para volver a publicarla.
  isArchived       Boolean  @default(false)
  isCombo          Boolean  @default(false)
  /// Minutos de preparación propios. `null` = usa el tiempo del negocio.
  prepMinutes      Int?
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization           Organization?             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category               Category?                 @relation(fields: [categoryId], references: [id])
  catalogEntry           CatalogEntry?             @relation(fields: [catalogEntryId], references: [id], onDelete: SetNull)
  defaultStation         KitchenStation?           @relation("ItemDefaultStation", fields: [defaultStationId], references: [id], onDelete: SetNull)
  stationRules           KitchenStationRule[]      @relation("ItemStationRule")
  soldIngredient         Ingredient?               @relation("IngredientSoldItem")
  variants               ItemVariant[]
  extras                 ItemExtra[]
  recipes                Recipe[]
  orderItems             OrderItem[]               @relation("OrderItemRef")
  ingredientExclusions   ItemIngredientExclusion[]
  optionGroups           ItemOptionGroup[]
  promotions             ComboPromotion[]          @relation("ComboPromotionItem")
  promotionsAsFree       ComboPromotion[]          @relation("ComboPromotionFreeItem")
  promotionsAsDiscounted ComboPromotion[]          @relation("ComboPromotionDiscountedItem")
  comboComponents        ComboComponent[]          @relation("ComboComponents")
  componentOf            ComboComponent[]          @relation("ComboPartOf")
  menuItems              MenuItem[]

  @@unique([organizationId, sku])
  @@index([organizationId, isActive])
  @@index([categoryId])
  @@map("Product")
}

model ItemVariant {
  id            String   @id @default(cuid())
  itemId        String   @map("productId")
  name          String // ej: "Chico", "Regular", "Grande", "Sin azúcar"
  /// SKU propio: el del artículo más el sufijo de la presentación (XVA101A).
  sku           String?
  /// Presentación que el menú muestra por defecto. Solo una por artículo.
  isPrimary     Boolean  @default(false)
  priceAdjust   Decimal  @default(0.0000) @db.Decimal(12, 2)
  /// Multiplicador del consumo de la receta base. Regular = 1.
  recipeFactor  Decimal  @default(1) @db.Decimal(6, 3)
  /// Imagen propia de la presentación. Si falta, se usa la del artículo.
  imageKey      String?
  imageUrl      String?
  /// Variantes optimizadas (AVIF + JPEG por ancho) con sus URLs públicas.
  imageVariants Json?
  /// Nombre legible de la imagen (solo referencia, como en CatalogEntry).
  imageName     String?
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  item                   Item               @relation(fields: [itemId], references: [id], onDelete: Cascade)
  orderItems             OrderItem[]
  recipes                Recipe[]
  recipeIngredients      RecipeIngredient[]
  comboComponents        ComboComponent[]
  promotionsAsFree       ComboPromotion[]   @relation("ComboPromotionFreeVariant")
  promotionsAsDiscounted ComboPromotion[]   @relation("ComboPromotionDiscountedVariant")

  @@index([itemId])
  @@map("ProductVariant")
}

model ItemExtra {
  id        String   @id @default(cuid())
  itemId    String   @map("productId")
  name      String
  price     Decimal  @db.Decimal(12, 2)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  item            Item                  @relation(fields: [itemId], references: [id], onDelete: Cascade)
  orderItemExtras OrderItemExtra[]
  ingredients     ItemExtraIngredient[]

  @@index([itemId])
  @@map("ProductExtra")
}

// ============================================================================
// Opciones configurables (grupos, valores y efectos)
// ============================================================================

/// Grupo de opciones del negocio (salsas, proteínas, leches, extras, "sin…").
/// Los grupos sugeridos por la app son plantillas: al usarlos se crea uno
/// propio de la organización para que se pueda editar sin afectar a otros.
model OptionGroup {
  id             String   @id @default(cuid())
  organizationId String?
  name           String
  description    String?
  sortOrder      Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization?     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  values       OptionValue[]
  itemGroups   ItemOptionGroup[]

  @@unique([organizationId, name])
  @@index([organizationId, isActive])
}

/// Valor de un grupo ("Salsa roja", "Bistec", "Leche de almendra").
model OptionValue {
  id           String   @id @default(cuid())
  groupId      String
  name         String
  /// Texto que se muestra a cocina; si falta se usa `name`.
  kitchenLabel String?
  sortOrder    Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  group      OptionGroup       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  itemValues ItemOptionValue[]

  @@unique([groupId, name])
  @@index([groupId])
}

/// Asignación de un grupo a un artículo, con sus reglas de selección.
model ItemOptionGroup {
  id         String          @id @default(cuid())
  itemId     String
  groupId    String
  isRequired Boolean         @default(false)
  selection  OptionSelection @default(SINGLE)
  minSelect  Int             @default(0)
  maxSelect  Int?
  sortOrder  Int             @default(0)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  item   Item              @relation(fields: [itemId], references: [id], onDelete: Cascade)
  group  OptionGroup       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  values ItemOptionValue[]

  @@unique([itemId, groupId])
  @@index([itemId])
  @@index([groupId])
}

/// Valor del grupo para un artículo concreto: aquí vive el precio y el default.
/// El mismo valor ("Bistec") puede costar distinto en dos platillos.
///
/// Si `valueId` viene de la biblioteca. Si es null, `customName` guarda una
/// opción propia del artículo que no modifica el grupo de la biblioteca.
model ItemOptionValue {
  id                String   @id @default(cuid())
  itemOptionGroupId String
  valueId           String?
  /// Opción propia del artículo (no existe en la biblioteca).
  customName        String?
  priceDelta        Decimal  @default(0) @db.Decimal(12, 2)
  /// Multiplicador del consumo de la receta para esta opción (tamaños).
  scaleFactor       Decimal  @default(1) @db.Decimal(6, 3)
  /// Opción que el POS preselecciona. Solo una por grupo.
  isDefault         Boolean  @default(false)
  sortOrder         Int      @default(0)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  itemOptionGroup ItemOptionGroup    @relation(fields: [itemOptionGroupId], references: [id], onDelete: Cascade)
  value           OptionValue?       @relation(fields: [valueId], references: [id], onDelete: Cascade)
  effects         ItemOptionEffect[]
  orderOptions    OrderItemOption[]

  @@unique([itemOptionGroupId, valueId])
  @@index([itemOptionGroupId])
  @@index([valueId])
}

/// Efecto de una opción sobre la receta (solo recetas publicadas).
/// - REPLACE: cambia el insumo de un slot de la receta.
/// - ADD: añade consumo de inventario.
/// - REMOVE: quita un slot o un insumo.
model ItemOptionEffect {
  id                   String             @id @default(cuid())
  itemOptionValueId    String
  action               OptionEffectAction
  /// Slot de la receta a reemplazar o quitar (null en ADD).
  recipeIngredientId   String?
  /// Insumo de la receta que se reemplaza (REPLACE) por `ingredientId`.
  replacesIngredientId String?
  /// Insumo que entra (REPLACE/ADD) o que se quita (REMOVE por insumo).
  ingredientId         String?
  quantity             Decimal?           @db.Decimal(12, 4)

  itemOptionValue    ItemOptionValue   @relation(fields: [itemOptionValueId], references: [id], onDelete: Cascade)
  recipeIngredient   RecipeIngredient? @relation(fields: [recipeIngredientId], references: [id], onDelete: Cascade)
  replacesIngredient Ingredient?       @relation("OptionEffectReplacesIngredient", fields: [replacesIngredientId], references: [id], onDelete: Cascade)
  ingredient         Ingredient?       @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@index([itemOptionValueId])
  @@index([recipeIngredientId])
  @@index([replacesIngredientId])
  @@index([ingredientId])
}

/// Promoción de un combo (descuento por porcentaje, importe fijo o 2x1).
/// `daysOfWeek` vacío = todos los días; las horas son "HH:MM" locales.
model ComboPromotion {
  id                  String        @id @default(cuid())
  itemId              String
  name                String
  type                PromotionType
  /// Porcentaje (0-100) o importe fijo en la moneda del negocio.
  value               Decimal       @default(0) @db.Decimal(12, 2)
  /// Para PAY_X_GET_Y: cantidad que paga y cantidad que recibe.
  payQuantity         Int?
  getQuantity         Int?
  /// Para SPECIAL_PRICE: precio final del combo.
  specialPrice        Decimal?      @db.Decimal(12, 2)
  /// Para FREE_ITEM: presentación del combo que sale gratis.
  freeItemId          String?
  freeVariantId       String?
  /// Para SECOND_HALF_PRICE: presentación a la que se aplica el 50 %.
  discountedItemId    String?
  discountedVariantId String?
  startsAt            DateTime?
  endsAt              DateTime?
  daysOfWeek          Int[]         @default([])
  startTime           String?
  endTime             String?
  isActive            Boolean       @default(true)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  item              Item         @relation("ComboPromotionItem", fields: [itemId], references: [id], onDelete: Cascade)
  freeItem          Item?        @relation("ComboPromotionFreeItem", fields: [freeItemId], references: [id], onDelete: SetNull)
  freeVariant       ItemVariant? @relation("ComboPromotionFreeVariant", fields: [freeVariantId], references: [id], onDelete: SetNull)
  discountedItem    Item?        @relation("ComboPromotionDiscountedItem", fields: [discountedItemId], references: [id], onDelete: SetNull)
  discountedVariant ItemVariant? @relation("ComboPromotionDiscountedVariant", fields: [discountedVariantId], references: [id], onDelete: SetNull)

  @@unique([itemId])
  @@index([itemId, isActive])
}

// ============================================================================
// Menús (colecciones curadas de artículos para filtrar el POS)
// ============================================================================

/// Colección de artículos y combos, opcionalmente programada por día/horario.
/// No se vende ni tiene precio: solo organiza/filtra el catálogo del POS.
model Menu {
  id             String  @id @default(cuid())
  organizationId String?
  name           String
  description    String?
  isActive       Boolean @default(true)
  /// Menú de referencia creado automáticamente con todo el catálogo.
  isGlobal       Boolean @default(false)
  sortOrder      Int     @default(0)

  /// Vigencia recurrente. `daysOfWeek` vacío = todos los días.
  daysOfWeek Int[]   @default([])
  startTime  String? // "HH:MM" local
  endTime    String? // "HH:MM" local; admite cruce de medianoche

  /// Secciones del menú (p. ej. «Bebidas frías»), en el orden en que se
  /// muestran en el POS. Un artículo sin grupo vive en «Sin grupo».
  groups String[] @default([])

  /// Color por sección (`{ "Bebidas frías": "sky-300" }`).
  groupColors Json?

  /// Vigencia por fechas (opcional).
  startsAt DateTime?
  endsAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization?        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  items        MenuItem[]
  stationRules KitchenStationRule[] @relation("MenuStationRule")

  @@unique([organizationId, name])
  @@index([organizationId, isActive])
}

/// Artículo incluido en un menú, con su orden dentro de la colección.
model MenuItem {
  id        String  @id @default(cuid())
  menuId    String
  itemId    String
  sortOrder Int     @default(0)
  /// Nombre del grupo del menú al que pertenece; `null` = «Sin grupo».
  group     String?

  menu Menu @relation(fields: [menuId], references: [id], onDelete: Cascade)
  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([menuId, itemId])
  @@index([menuId])
  @@index([itemId])
}

// ============================================================================
// Inventario y recetas
// ============================================================================

model Ingredient {
  id             String   @id @default(cuid())
  organizationId String?
  name           String
  sku            String? // Código interno / referencia proveedor
  /**
   * Unidad canónica de almacenamiento: siempre G, ML o UNIT.
   */
  baseUnit       UnitCode @default(UNIT)
  /**
   * Unidad con la que el usuario ve y captura las cantidades (misma dimensión).
   */
  displayUnit    UnitCode @default(UNIT)
  currentStock   Decimal  @default(0.0000) @db.Decimal(12, 4)
  minStock       Decimal  @default(0.0000) @db.Decimal(12, 4)
  maxStock       Decimal? @db.Decimal(12, 4) // Existencia máxima (opcional)
  unitCost       Decimal? @db.Decimal(12, 6) // Costo por unidad canónica
  isActive       Boolean  @default(true)
  /// Artículo del POS que se vende a partir de este insumo (si aplica).
  soldItemId     String?  @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  categoryId String?
  locationId String?

  organization           Organization?               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category               IngredientCategory?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  location               IngredientLocation?         @relation(fields: [locationId], references: [id], onDelete: SetNull)
  soldItem               Item?                       @relation("IngredientSoldItem", fields: [soldItemId], references: [id], onDelete: SetNull)
  recipeIngredients      RecipeIngredient[]
  ingredientOptions      RecipeIngredientOption[]
  orderChoices           OrderItemIngredientChoice[]
  producedByRecipe       Recipe?                     @relation("RecipeProducedIngredient")
  inventoryMovements     InventoryMovement[]
  equivalences           IngredientEquivalence[]
  exclusions             ItemIngredientExclusion[]
  extraIngredients       ItemExtraIngredient[]
  orderItemExclusions    OrderItemExclusion[]
  optionEffects          ItemOptionEffect[]
  optionEffectsReplacing ItemOptionEffect[]          @relation("OptionEffectReplacesIngredient")
  branchStocks           BranchStock[]
  wastes                 Waste[]

  @@unique([organizationId, name])
  @@unique([organizationId, sku])
  @@index([organizationId, isActive])
  @@index([organizationId, categoryId])
  @@index([organizationId, locationId])
}

/// Equivalencia explícita entre dimensiones distintas para UN ingrediente
/// (ej. 1 taza de harina = 120 g). Nunca se deduce masa ↔ volumen.
/// Las unidades implicadas se normalizan a la canónica de su dimensión.
model IngredientCategory {
  id             String   @id @default(cuid())
  organizationId String?
  name           String
  description    String?
  isCore         Boolean  @default(false) // true = parte del core de la app, no editable
  isActive       Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ingredients  Ingredient[]

  @@unique([organizationId, name])
  @@index([organizationId, isActive])
}

model IngredientLocation {
  id             String   @id @default(cuid())
  organizationId String?
  name           String
  description    String?
  isCore         Boolean  @default(false) // true = parte del core de la app, no editable
  isActive       Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ingredients  Ingredient[]

  @@unique([organizationId, name])
  @@index([organizationId, isActive])
}

model IngredientEquivalence {
  id           String   @id @default(cuid())
  ingredientId String
  fromUnit     UnitCode
  toUnit       UnitCode
  factor       Decimal  @db.Decimal(12, 6) // 1 fromUnit = factor toUnit
  note         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@unique([ingredientId, fromUnit, toUnit])
  @@index([ingredientId])
}

/// Ingredientes que el cliente puede pedir sin incluir ("sin cebolla").
model ItemIngredientExclusion {
  id           String   @id @default(cuid())
  itemId       String   @map("productId")
  ingredientId String
  label        String?
  createdAt    DateTime @default(now())

  item       Item       @relation(fields: [itemId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@unique([itemId, ingredientId])
  @@index([itemId])
  @@index([ingredientId])
  @@map("ProductIngredientExclusion")
}

/// Componentes de un combo. No se permiten combos anidados (validación en API).
model ComboComponent {
  id                 String   @id @default(cuid())
  comboId            String
  componentItemId    String   @map("componentProductId")
  componentVariantId String?
  quantity           Int      @default(1)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  combo         Item         @relation("ComboComponents", fields: [comboId], references: [id], onDelete: Cascade)
  componentItem Item         @relation("ComboPartOf", fields: [componentItemId], references: [id], onDelete: Restrict)
  variant       ItemVariant? @relation(fields: [componentVariantId], references: [id], onDelete: Restrict)

  @@unique([comboId, componentItemId, componentVariantId])
  @@index([comboId])
  @@index([componentItemId])
}

/// Consumo de inventario de un extra (cantidad en la unidad canónica del ingrediente).
model ItemExtraIngredient {
  id           String  @id @default(cuid())
  itemExtraId  String  @map("productExtraId")
  ingredientId String
  quantity     Decimal @db.Decimal(12, 4)

  itemExtra  ItemExtra  @relation(fields: [itemExtraId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@unique([itemExtraId, ingredientId])
  @@index([ingredientId])
  @@map("ProductExtraIngredient")
}

model Recipe {
  id                   String    @id @default(cuid())
  organizationId       String?
  /// `null` = receta independiente (aún no publicada como artículo).
  itemId               String?   @map("productId")
  variantId            String? // null = receta base del artículo
  categoryId           String?
  name                 String
  description          String?
  /// Notas de preparación, tiempos, conservación, etc.
  notes                String?
  /// Identidad del catálogo: la misma que el artículo publicado.
  catalogEntryId       String?
  /// Insumo que produce esta receta (ej. salsa verde). Único por receta.
  producesIngredientId String?   @unique
  yieldQuantity        Decimal?  @db.Decimal(12, 4)
  yieldUnit            UnitCode?
  isActive             Boolean   @default(true)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  organization       Organization?      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  item               Item?              @relation(fields: [itemId], references: [id], onDelete: Cascade)
  variant            ItemVariant?       @relation(fields: [variantId], references: [id], onDelete: Cascade)
  catalogEntry       CatalogEntry?      @relation(fields: [catalogEntryId], references: [id], onDelete: SetNull)
  category           Category?          @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  producesIngredient Ingredient?        @relation("RecipeProducedIngredient", fields: [producesIngredientId], references: [id], onDelete: SetNull)
  ingredients        RecipeIngredient[]

  @@unique([itemId, variantId])
  @@index([organizationId])
  @@index([variantId])
  @@index([categoryId])
  @@index([catalogEntryId])
}

model RecipeIngredient {
  id           String  @id @default(cuid())
  recipeId     String
  /// Insumo default del slot (puede cambiarse al pedir entre las alternativas).
  ingredientId String
  /// `null` = común a todas las presentaciones; si no, solo a esa.
  variantId    String?
  /// Nombre del slot (ej. "Leche"); si falta se usa el nombre del insumo.
  label        String?
  quantity     Decimal @db.Decimal(12, 4) // Cantidad en la unidad canónica del ingrediente
  isOptional   Boolean @default(false)
  sortOrder    Int     @default(0)

  recipe        Recipe                      @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredient    Ingredient                  @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  variant       ItemVariant?                @relation(fields: [variantId], references: [id], onDelete: Cascade)
  options       RecipeIngredientOption[]
  orderChoices  OrderItemIngredientChoice[]
  optionEffects ItemOptionEffect[]

  @@index([recipeId, variantId])
  @@index([ingredientId])
  @@index([variantId])
}

/// Alternativa de un ingrediente de receta (ej. leche deslactosada o de coco).
/// Cada alternativa guarda su propia cantidad en la unidad canónica de su insumo.
model RecipeIngredientOption {
  id                 String  @id @default(cuid())
  recipeIngredientId String
  ingredientId       String
  quantity           Decimal @db.Decimal(12, 4)
  sortOrder          Int     @default(0)

  recipeIngredient RecipeIngredient @relation(fields: [recipeIngredientId], references: [id], onDelete: Cascade)
  ingredient       Ingredient       @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@unique([recipeIngredientId, ingredientId])
  @@index([recipeIngredientId])
  @@index([ingredientId])
}

/// Opción elegida al vender una línea (soporte para cambiar el default en pedidos).
model OrderItemIngredientChoice {
  id                 String @id @default(cuid())
  orderItemId        String
  recipeIngredientId String
  ingredientId       String

  orderItem        OrderItem        @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  recipeIngredient RecipeIngredient @relation(fields: [recipeIngredientId], references: [id], onDelete: Cascade)
  ingredient       Ingredient       @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@unique([orderItemId, recipeIngredientId])
  @@index([recipeIngredientId])
  @@index([ingredientId])
}

model InventoryMovement {
  id             String                @id @default(cuid())
  organizationId String
  branchId       String?
  /// `null` si el producto se eliminó; el kardex se conserva.
  ingredientId   String?
  /// Nombre del producto en el momento del movimiento (snapshot).
  ingredientName String
  /// Unidad visible del producto en el momento del movimiento.
  displayUnit    UnitCode
  userId         String?
  type           InventoryMovementType
  quantity       Decimal               @db.Decimal(12, 4) // Positivo = entrada, Negativo = salida
  stockAfter     Decimal?              @db.Decimal(12, 4) // Saldo resultante (kardex auditable)
  reason         String?
  /// Costo por unidad canónica en el momento del movimiento (compras).
  unitCost       Decimal?              @db.Decimal(12, 6)
  referenceId    String? // ID de orden, ronda, etc.
  referenceType  String? // "ORDER_ROUND", "ADJUSTMENT", etc.
  dedupeKey      String?               @unique // idempotencia de consumos
  createdAt      DateTime              @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  // `SetNull`: el kardex se conserva aunque se elimine el producto.
  ingredient   Ingredient?  @relation(fields: [ingredientId], references: [id], onDelete: SetNull)
  // `SetNull`: el kardex se conserva aunque se elimine la cuenta del autor.
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([branchId, createdAt])
  @@index([ingredientId])
  @@index([userId])
}

// ============================================================================
// Pedidos y cocina
// ============================================================================

model Order {
  id              String       @id @default(cuid())
  organizationId  String?
  branchId        String?
  tableNumber     String?
  /// Número de comensales de la mesa (1–20).
  partySize       Int          @default(1)
  isTakeaway      Boolean      @default(false)
  /// Canal de venta; `isTakeaway` se conserva por compatibilidad histórica.
  channel         OrderChannel @default(DINE_IN)
  customerName    String?
  customerPhone   String?
  deliveryAddress String?
  deliveryFee     Decimal      @default(0) @db.Decimal(12, 2)
  scheduledAt     DateTime?
  /// Consecutivo diario por sucursal (control antifraude).
  ticketNumber    Int?
  /// Identificador legible para reclamos: AAAAMMDD + consecutivo de 3 dígitos.
  ticketUid       String?
  /// Nombre del usuario que tomó la orden (histórico del ticket).
  servedByName    String?
  status          OrderStatus  @default(OPEN)
  subtotal        Decimal      @default(0.0000) @db.Decimal(12, 2)
  taxTotal        Decimal      @default(0.0000) @db.Decimal(12, 2)
  total           Decimal      @default(0.0000) @db.Decimal(12, 2)
  idempotencyKey  String?      @unique
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  // `SetNull`: al eliminar la cuenta del usuario el pedido se conserva sin autor.
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId       String?
  rounds       OrderRound[]
  payments     Payment[]
  guests       OrderGuest[]
  splits       OrderSplit[]

  @@unique([branchId, ticketUid])
  @@index([organizationId, createdAt])
  @@index([organizationId, status, createdAt])
  @@index([branchId, status, createdAt])
  @@index([branchId, createdAt])
  @@index([organizationId, ticketUid])
}

/// Persona dentro de una cuenta (opcional). Permite pedir por comensal.
model OrderGuest {
  id        String         @id @default(cuid())
  orderId   String
  /// Vacío cuando la persona todavía no tiene nombre.
  name      String         @default("")
  /// Tratamiento demográfico legado; se conserva para registros anteriores.
  title     GuestTitle?
  /// Sexo declarado (opcional).
  sex       GuestSex?
  /// Rango de edad declarado (opcional).
  ageRange  GuestAgeRange?
  sortOrder Int            @default(0)
  createdAt DateTime       @default(now())

  order  Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  items  OrderItem[]
  splits OrderSplit[]

  @@index([orderId])
}

/// Parte de una cuenta cuando se cobra dividida.
model OrderSplit {
  id             String      @id @default(cuid())
  orderId        String
  /// Cliente de la parte en el modo BY_GUEST.
  guestId        String?
  /// Nombre visible: «Ana», «Parte 2 de 3», «Adicional».
  label          String?
  mode           SplitMode
  /// Importe que debe cubrir esta parte, con IVA.
  expectedAmount Decimal     @db.Decimal(12, 2)
  status         SplitStatus @default(OPEN)
  sortOrder      Int         @default(0)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  order    Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  guest    OrderGuest? @relation(fields: [guestId], references: [id], onDelete: SetNull)
  payments Payment[]

  @@index([orderId, status])
  @@index([guestId])
}

model OrderRound {
  id               String           @id @default(cuid())
  orderId          String
  status           OrderRoundStatus @default(PENDING)
  courseId         String?
  heldAt           DateTime?
  firedAt          DateTime?
  idempotencyKey   String?          @unique
  sentAt           DateTime?
  startedAt        DateTime?
  readyAt          DateTime?
  deliveredAt      DateTime?
  cancelledAt      DateTime?
  /// Tiempo estimado de preparación al enviar la ronda, en minutos.
  estimatedMinutes Int?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  order         Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  course        KitchenCourse?       @relation(fields: [courseId], references: [id], onDelete: SetNull)
  items         OrderItem[]
  statusHistory OrderStatusHistory[]
  tickets       KitchenTicket[]

  @@index([orderId])
  @@index([status, createdAt])
}

model OrderItem {
  id             String         @id @default(cuid())
  orderRoundId   String
  itemId         String         @map("productId")
  itemVariantId  String?        @map("productVariantId")
  // Copia histórica del catálogo al momento del pedido
  itemName       String         @map("productName")
  variantName    String?
  itemPrice      Decimal        @map("productPrice") @db.Decimal(12, 2)
  taxRate        Decimal?       @db.Decimal(5, 4)
  taxAmount      Decimal        @default(0) @db.Decimal(12, 2)
  quantity       Int            @default(1)
  notes          String?
  subtotal       Decimal        @db.Decimal(12, 2)
  /// Descuento aplicado por una promoción del combo (no altera `itemPrice`).
  discountAmount Decimal        @default(0) @db.Decimal(12, 2)
  /// Snapshot de la promoción aplicada, para reportes y marketing.
  promotionId    String?
  promotionName  String?
  promotionType  PromotionType?
  /// Persona de la cuenta a la que pertenece la línea (opcional).
  guestId        String?
  /// Nombre de la persona al momento del pedido (se conserva si se elimina).
  guestName      String?
  /// Estación de cocina asignada al enviar la ronda (modo Avanzado).
  stationId      String?

  orderRound        OrderRound                  @relation(fields: [orderRoundId], references: [id], onDelete: Cascade)
  item              Item                        @relation("OrderItemRef", fields: [itemId], references: [id], onDelete: Restrict)
  variant           ItemVariant?                @relation(fields: [itemVariantId], references: [id])
  guest             OrderGuest?                 @relation(fields: [guestId], references: [id], onDelete: SetNull)
  station           KitchenStation?             @relation(fields: [stationId], references: [id], onDelete: SetNull)
  extras            OrderItemExtra[]
  exclusions        OrderItemExclusion[]
  options           OrderItemOption[]
  ingredientChoices OrderItemIngredientChoice[]
  kitchenTickets    KitchenTicketItem[]

  @@index([orderRoundId])
  @@index([itemId])
  @@index([guestId])
}

model OrderItemExtra {
  id          String  @id @default(cuid())
  orderItemId String
  itemExtraId String? @map("productExtraId")
  extraName   String
  extraPrice  Decimal @db.Decimal(12, 2)

  orderItem OrderItem  @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  itemExtra ItemExtra? @relation(fields: [itemExtraId], references: [id])

  @@index([orderItemId])
}

/// Opción elegida en una línea, con snapshot para cocina, ticket y reportes.
model OrderItemOption {
  id                String  @id @default(cuid())
  orderItemId       String
  itemOptionValueId String?
  groupName         String
  optionName        String
  kitchenLabel      String?
  priceDelta        Decimal @default(0) @db.Decimal(12, 2)

  orderItem       OrderItem        @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  itemOptionValue ItemOptionValue? @relation(fields: [itemOptionValueId], references: [id], onDelete: SetNull)

  @@index([orderItemId])
  @@index([itemOptionValueId])
}

/// Ingredientes que el cliente pidió quitar. Se descuentan de la receta al
/// consumir inventario, para que el descuento coincida con lo servido.
model OrderItemExclusion {
  id           String @id @default(cuid())
  orderItemId  String
  ingredientId String

  orderItem  OrderItem  @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@unique([orderItemId, ingredientId])
  @@index([ingredientId])
}

model OrderStatusHistory {
  id             String   @id @default(cuid())
  orderRoundId   String
  previousStatus String?
  newStatus      String
  changedById    String?
  changedAt      DateTime @default(now())
  reason         String?

  orderRound OrderRound @relation(fields: [orderRoundId], references: [id], onDelete: Cascade)
  // `SetNull`: la traza de estados se conserva sin autor si se borra la cuenta.
  changedBy  User?      @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@index([orderRoundId])
  @@index([changedAt])
}

// ============================================================================
// Pagos y auditoría
// ============================================================================

model Payment {
  id             String        @id @default(cuid())
  organizationId String?
  branchId       String?
  orderId        String
  userId         String?
  method         PaymentMethod
  amount         Decimal       @db.Decimal(12, 2)
  status         PaymentStatus @default(PENDING)
  paidAt         DateTime?
  confirmedAt    DateTime?
  confirmedById  String?
  idempotencyKey String?
  /// Referencia externa del cobro (autorización, voucher o terminal ajena).
  reference      String?

  // Propinas y control de caja.
  tipAmount      Decimal   @default(0) @db.Decimal(12, 2)
  /// Porcentaje de propina aplicado (0–100); `null` si fue un monto manual.
  tipPercent     Decimal?  @db.Decimal(5, 2)
  /// De dónde salió la propina.
  tipSource      TipSource @default(NONE)
  /// Base sobre la que se calculó el porcentaje.
  tipBaseAmount  Decimal?  @db.Decimal(12, 2)
  tipRecipientId String?
  cashReceived   Decimal?  @db.Decimal(12, 2)
  changeGiven    Decimal?  @db.Decimal(12, 2)
  sessionId      String?
  /// Parte de la cuenta a la que se aplica el pago, si está dividida.
  splitId        String?

  // Integración con proveedores de pago (Mercado Pago Point / link).
  provider             String?
  providerOrderId      String?   @unique
  providerPreferenceId String?   @unique
  providerCheckoutUrl  String?
  providerPaymentId    String?
  providerStatus       String?
  providerStatusDetail String?
  terminalId           String?
  expiresAt            DateTime?
  providerData         Json?

  // Cobros capturados sin conexión.
  /// Dispositivo que capturó el cobro offline (identificador local, no secreto).
  offlineDeviceId  String?
  /// Hora local declarada por el dispositivo al capturar el cobro.
  createdOfflineAt DateTime?
  /// Cobro offline que requiere conciliación humana antes de darse por cobrado.
  reviewRequired   Boolean   @default(false)
  /// Motivo por el que el cobro requiere revisión.
  reviewReason     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  order        Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  // `SetNull`: el pago sobrevive al borrado de la cuenta que lo registró.
  user         User?         @relation("PaymentUser", fields: [userId], references: [id], onDelete: SetNull)
  confirmedBy  User?         @relation("PaymentConfirmedBy", fields: [confirmedById], references: [id], onDelete: SetNull)
  tipRecipient User?         @relation("PaymentTipRecipient", fields: [tipRecipientId], references: [id], onDelete: SetNull)
  session      CashSession?  @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  split        OrderSplit?   @relation(fields: [splitId], references: [id], onDelete: SetNull)

  /// La idempotencia es por negocio: dos negocios pueden repetir la misma
  /// clave sin colisionar. Postgres permite varios `NULL`.
  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, status, createdAt])
  @@index([organizationId, status, confirmedAt])
  @@index([branchId, createdAt])
  @@index([branchId, status, confirmedAt])
  @@index([orderId])
  @@index([provider, providerStatus])
  @@index([sessionId])
  @@index([organizationId, reviewRequired, status])
  @@index([sessionId, reviewRequired])
  @@index([tipRecipientId])
  @@index([splitId])
}

// ============================================================================
// Caja (turnos, movimientos y consecutivo de tickets)
// ============================================================================

/// Turno de caja de una sucursal. Solo puede haber uno `OPEN` por sucursal
/// (y uno por organización cuando no hay sucursal); la regla se refuerza con
/// un índice parcial en la migración.
model CashSession {
  id                  String            @id @default(cuid())
  organizationId      String
  branchId            String?
  status              CashSessionStatus @default(OPEN)
  openedById          String?
  openedAt            DateTime          @default(now())
  openingFloat        Decimal           @default(0) @db.Decimal(12, 2)
  closedById          String?
  closedAt            DateTime?
  countedCash         Decimal?          @db.Decimal(12, 2)
  expectedCash        Decimal?          @db.Decimal(12, 2)
  difference          Decimal?          @db.Decimal(12, 2)
  notes               String?
  /// Clave de idempotencia del cierre (reintentos offline).
  closeIdempotencyKey String?           @unique
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch?        @relation(fields: [branchId], references: [id], onDelete: SetNull)
  openedBy     User?          @relation("CashSessionOpenedBy", fields: [openedById], references: [id], onDelete: SetNull)
  closedBy     User?          @relation("CashSessionClosedBy", fields: [closedById], references: [id], onDelete: SetNull)
  payments     Payment[]
  movements    CashMovement[]

  @@index([organizationId, branchId, status])
  @@index([openedAt])
}

/// Movimiento manual de efectivo del turno (retiro, ingreso o gasto).
model CashMovement {
  id             String           @id @default(cuid())
  organizationId String
  branchId       String?
  sessionId      String
  type           CashMovementType
  amount         Decimal          @db.Decimal(12, 2)
  reason         String
  userId         String?
  createdAt      DateTime         @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  session      CashSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([sessionId])
  @@index([organizationId, createdAt])
}

/// Consecutivo diario por sucursal para numerar los tickets de venta.
model BranchDailySequence {
  id         String   @id @default(cuid())
  branchId   String
  date       DateTime @db.Date
  lastNumber Int      @default(0)

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([branchId, date])
}

// ============================================================================
// Caja vinculada por QR y PIN
// ============================================================================

/// Tablet/caja vinculada a una sucursal mediante un QR de un solo uso.
model PosDevice {
  id             String    @id @default(cuid())
  organizationId String
  branchId       String?
  name           String
  /// SHA-256 del token del dispositivo; el token real solo vive en la cookie.
  tokenHash      String    @unique
  isActive       Boolean   @default(true)
  lastSeenAt     DateTime?
  pairedById     String?
  createdAt      DateTime  @default(now())
  revokedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  pairedBy     User?        @relation("PosDevicePairedBy", fields: [pairedById], references: [id], onDelete: SetNull)

  @@index([organizationId, branchId])
}

/// Código temporal que se muestra como QR para vincular una caja.
model PosPairing {
  id             String    @id @default(cuid())
  organizationId String
  branchId       String?
  codeHash       String    @unique
  createdById    String?
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  createdBy    User?        @relation("PosPairingCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([expiresAt])
}

/// Pantalla de cliente (monitor/tablet frente al cliente).
model PosDisplay {
  id             String    @id @default(cuid())
  organizationId String
  branchId       String?
  name           String
  tokenHash      String    @unique
  isActive       Boolean   @default(true)
  /// Último estado publicado por el POS (líneas, total, propina, confirmación).
  state          Json?
  stateUpdatedAt DateTime?
  lastSeenAt     DateTime?
  createdById    String?
  createdAt      DateTime  @default(now())
  revokedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  createdBy    User?        @relation("PosDisplayCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([organizationId, branchId])
}

// ============================================================================
// Mercado Pago Point
// ============================================================================

/// Cuenta de Mercado Pago vinculada por una organización (OAuth marketplace).
///
/// Los tokens se guardan cifrados con AES-256-GCM (`TokenCipher`); nunca se
/// exponen al frontend ni se registran en logs.
model MercadoPagoConnection {
  id                String    @id @default(cuid())
  organizationId    String    @unique
  mpUserId          String
  /// Correo y apodo de la cuenta autorizada, para que el negocio vea cuál está conectada.
  mpEmail           String?
  mpNickname        String?
  accessTokenEnc    String
  refreshTokenEnc   String
  expiresAt         DateTime
  scopes            String[]  @default([])
  /// ACTIVE | ERROR | REVOKED
  status            String    @default("ACTIVE")
  connectedById     String?
  connectedAt       DateTime  @default(now())
  lastRefreshedAt   DateTime?
  /// Último intento de sincronización de terminales con Mercado Pago.
  terminalsSyncedAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

/// Terminal Point sincronizada desde Mercado Pago.
model MercadoPagoTerminal {
  id             String    @id @default(cuid())
  organizationId String
  branchId       String?
  terminalId     String
  name           String?
  /// PDV | STANDALONE | SELF_SERVICE
  operatingMode  String?
  /// SMART_1 | SMART_2 | AIR_2. Se elige en la app; la API no expone el modelo.
  model          String?
  /// Sucursal de Mercado Pago (`store_id`).
  storeId        String?
  /// Caja de Mercado Pago (`pos_id`).
  posId          String?
  /// Identificador externo de la caja (`external_pos_id`).
  externalPosId  String?
  isDefault      Boolean   @default(false)
  isActive       Boolean   @default(true)
  lastSyncedAt   DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@unique([organizationId, terminalId])
  @@index([organizationId, branchId])
}

/// Notificación recibida de Mercado Pago. Se guarda antes de procesarla para
/// deduplicar reintentos (`requestId`) y poder auditar eventos fallidos.
model MercadoPagoWebhookEvent {
  id              String    @id @default(cuid())
  requestId       String?   @unique
  topic           String
  providerOrderId String?
  payload         Json
  processedAt     DateTime?
  error           String?
  receivedAt      DateTime  @default(now())

  @@index([providerOrderId])
  @@index([receivedAt])
}

// ============================================================================
// Suscripciones de la plataforma (planes que pagan los negocios a Mishef)
// ============================================================================

enum BillingInterval {
  MONTH
  YEAR
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  PAUSED
  CANCELED
  EXPIRED
}

enum SubscriptionProvider {
  MERCADO_PAGO
  MANUAL
}

enum PlanChangeStatus {
  PENDING
  PAID
  CANCELED
}

/// Plan comercial de Mishef. Los precios son editables desde /plans.
model Plan {
  id           String  @id @default(cuid())
  code         String  @unique
  name         String
  description  String?
  priceMonthly Decimal @db.Decimal(10, 2)
  priceYearly  Decimal @db.Decimal(10, 2)
  currency     String  @default("MXN")
  /// El precio se multiplica por la cantidad de sucursales activas.
  perBranch    Boolean @default(false)
  trialDays    Int     @default(14)

  maxBranches       Int?
  maxUsersPerBranch Int?
  maxImagesPerItem  Int     @default(1)
  maxVideosPerItem  Int     @default(0)
  maxStorageBytes   BigInt?
  maxInventoryItems Int?
  customDomain      Boolean @default(false)

  isActive  Boolean @default(true)
  isPublic  Boolean @default(true)
  sortOrder Int     @default(0)
  features  Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions OrganizationSubscription[]
  changesFrom   PlanChange[]               @relation("PlanChangeFrom")
  changesTo     PlanChange[]               @relation("PlanChangeTo")
}

/// Suscripción de un negocio a un plan de Mishef.
model OrganizationSubscription {
  id             String               @id @default(cuid())
  organizationId String               @unique
  planId         String
  status         SubscriptionStatus   @default(TRIALING)
  provider       SubscriptionProvider @default(MERCADO_PAGO)
  interval       BillingInterval      @default(MONTH)
  /// Sucursales activas al contratar (planes por sucursal).
  quantity       Int                  @default(1)
  /// Precio unitario del plan al contratar (mensual o anual).
  unitAmount     Decimal              @db.Decimal(10, 2)
  currency       String               @default("MXN")

  providerPreapprovalId String? @unique
  payerEmail            String?

  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  trialEndsAt        DateTime?
  graceEndsAt        DateTime?
  canceledAt         DateTime?
  pausedAt           DateTime?
  lastSyncedAt       DateTime?

  /// Saldo a favor en centavos para la siguiente renovación.
  creditBalanceCents Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan         Plan                  @relation(fields: [planId], references: [id], onDelete: Restrict)
  payments     SubscriptionPayment[]
  changes      PlanChange[]

  @@index([planId, status])
  @@index([status, currentPeriodEnd])
}

/// Cambio de plan con prorrateo (upgrade).
model PlanChange {
  id                    String           @id @default(cuid())
  subscriptionId        String
  fromPlanId            String
  toPlanId              String
  interval              BillingInterval
  quantity              Int
  /// Valor de los días restantes del plan anterior, en centavos.
  creditCents           Int
  /// Diferencia a cobrar en el primer cargo, en centavos.
  amountDueCents        Int
  status                PlanChangeStatus @default(PENDING)
  previousPreapprovalId String?
  providerPreapprovalId String?
  effectiveAt           DateTime?
  appliedAt             DateTime?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  subscription OrganizationSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  fromPlan     Plan                     @relation("PlanChangeFrom", fields: [fromPlanId], references: [id], onDelete: Restrict)
  toPlan       Plan                     @relation("PlanChangeTo", fields: [toPlanId], references: [id], onDelete: Restrict)

  @@index([subscriptionId, status])
}

/// Pago individual de una suscripción (cobro recurrente o prorrateo).
model SubscriptionPayment {
  id                String    @id @default(cuid())
  subscriptionId    String
  organizationId    String
  kind              String    @default("SUBSCRIPTION")
  status            String
  amountCents       Int
  currency          String    @default("MXN")
  providerPaymentId String?   @unique
  periodStart       DateTime?
  periodEnd         DateTime?
  paidAt            DateTime?
  raw               Json?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  subscription OrganizationSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([subscriptionId, createdAt])
}

/// Notificación del webhook de suscripciones (app de billing).
model BillingWebhookEvent {
  id          String    @id @default(cuid())
  requestId   String?   @unique
  topic       String
  providerId  String?
  payload     Json
  processedAt DateTime?
  error       String?
  receivedAt  DateTime  @default(now())

  @@index([providerId])
  @@index([receivedAt])
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String?
  userId         String?
  action         String
  entity         String
  entityId       String?
  oldValues      Json?
  newValues      Json?
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // `SetNull`: la auditoría se conserva aunque la cuenta ya no exista.
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([userId])
  @@index([entity, entityId])
}

// ============================================================================
// Anal�tica de uso (eventos append-only para reportes y modelos predictivos)
// ============================================================================

/// Evento de uso del sistema (opciones, ventas, men�s, POS...).
///
/// Sin claves for�neas a prop�sito: el hist�rico debe sobrevivir al borrado o
/// renombrado de grupos, art�culos, men�s y pedidos. Los nombres se guardan
/// como snapshot (`subjectName` y `metadata`) para que los reportes no cambien.
model AnalyticsEvent {
  id             String   @id @default(cuid())
  organizationId String?
  branchId       String?
  userId         String?
  /// Nombre del evento, p. ej. "option_group.selected".
  name           String
  /// Entidad protagonista: "optionGroup", "optionValue", "item", "menu", "order".
  subjectType    String?
  subjectId      String?
  /// Snapshot del nombre de la entidad protagonista.
  subjectName    String?
  itemId         String?
  orderId        String?
  menuId         String?
  quantity       Decimal  @default(0) @db.Decimal(12, 4)
  amount         Decimal  @default(0) @db.Decimal(12, 2)
  /// Datos libres del evento (valor elegido, posici�n, etc.).
  metadata       Json?
  occurredAt     DateTime @default(now())

  @@index([organizationId, name, occurredAt])
  @@index([subjectType, subjectId, occurredAt])
  @@index([itemId, occurredAt])
  @@index([menuId, occurredAt])
  @@index([orderId])
  @@index([occurredAt])
}

// ============================================================================
// Procesamiento de imagenes en segundo plano
// ============================================================================

enum ImageJobStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}

enum ImageJobTarget {
  CATALOG_ENTRY
  VARIANT
}

/// Trabajo de optimizacion de una imagen subida a R2.
///
/// El navegador sube el original a \`tmp/\` y crea un job. Un worker en la API
/// genera las variantes AVIF/JPEG, las guarda y actualiza la entidad destino.
model ImageJob {
  id             String         @id @default(cuid())
  organizationId String
  target         ImageJobTarget
  /// CatalogEntry.id o ItemVariant.id segun \`target\`.
  targetId       String
  /// Item.id, solo para variantes (lo exige \`applyVariantImage\`).
  itemId         String?
  /// Nombre legible para el snapshot de la imagen.
  imageName      String?
  /// Carpeta final en R2 donde se guardan las variantes.
  folder         String
  /// Objeto temporal subido por el navegador.
  tempKey        String
  status         ImageJobStatus @default(PENDING)
  result         Json?
  error          String?
  createdAt      DateTime       @default(now())
  startedAt      DateTime?
  finishedAt     DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([status, createdAt])
}

/// Invitación para que una persona entre al equipo de un negocio.
///
/// El token se guarda hasheado: si alguien obtiene una copia de la base no
/// puede canjear invitaciones. Caduca y solo sirve una vez.
model Invitation {
  id             String    @id @default(cuid())
  organizationId String
  email          String
  roles          Role[]    @default([])
  branchId       String?
  /// Nombre visible y username local que tendrá al aceptar.
  name           String?
  username       String?
  tokenHash      String    @unique
  invitedById    String?
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, email])
  @@index([expiresAt])
}

/// Turno de trabajo (checador). Un turno abierto por persona a la vez.
model Shift {
  id                 String           @id @default(cuid())
  organizationId     String
  branchId           String?
  userId             String
  /// Hora real de entrada (nunca se reescribe; el log está en AttendanceEvent).
  startedAt          DateTime         @default(now())
  /// Hora real de salida.
  endedAt            DateTime?
  /// Hora efectiva para nómina, ajustada por las tolerancias vigentes.
  effectiveStartedAt DateTime?
  effectiveEndedAt   DateTime?
  /// Horario publicado que se usó para calcular las tolerancias.
  scheduleEntryId    String?
  scheduledStartedAt DateTime?
  scheduledEndedAt   DateTime?
  note               String?
  /// Quién operó el checador; `null` = el propio empleado desde su cuenta.
  recordedById       String?
  source             AttendanceSource @default(WEB)
  /// Resultado de la geocerca al momento de la checada.
  withinGeofence     Boolean?
  /// Checada fuera de zona/horario que un ADMIN debe autorizar.
  needsReview        Boolean          @default(false)
  reviewedById       String?
  reviewedAt         DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  organization  Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch        Branch?                @relation(fields: [branchId], references: [id], onDelete: SetNull)
  user          User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  recordedBy    User?                  @relation("ShiftRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)
  reviewedBy    User?                  @relation("ShiftReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  scheduleEntry ScheduleEntry?         @relation(fields: [scheduleEntryId], references: [id], onDelete: SetNull)
  breaks        ShiftBreak[]
  adjustments   AttendanceAdjustment[]
  events        AttendanceEvent[]

  @@index([organizationId, startedAt])
  @@index([userId, startedAt])
  @@index([userId, endedAt])
  @@index([scheduleEntryId])
}

enum ShiftBreakType {
  LUNCH
  REST
  OTHER
}

enum AttendanceSource {
  WEB
  KIOSK
  ADMIN
  OFFLINE
}

enum AttendanceEventType {
  CLOCK_IN
  LUNCH_START
  LUNCH_END
  BREAK_START
  BREAK_END
  CLOCK_OUT
  ADJUSTMENT
  REVIEW
}

/// Descanso o comida dentro de un turno.
model ShiftBreak {
  id               String         @id @default(cuid())
  shiftId          String
  type             ShiftBreakType
  startedAt        DateTime
  endedAt          DateTime?
  /// Minutos que se descuentan de la jornada después de la tolerancia.
  effectiveMinutes Int?
  note             String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  shift Shift @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  @@index([shiftId, startedAt])
}

/// Minutos positivos agregados por un ADMIN (nunca se restan).
model AttendanceAdjustment {
  id             String   @id @default(cuid())
  organizationId String
  branchId       String?
  shiftId        String
  /// Empleado al que se le ajustan las horas.
  userId         String
  minutes        Int
  reason         String
  createdById    String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  shift        Shift        @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  user         User         @relation("AttendanceAdjustmentUser", fields: [userId], references: [id], onDelete: Cascade)
  createdBy    User         @relation("AttendanceAdjustmentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([shiftId, createdAt])
  @@index([organizationId, createdAt])
}

/// Log inmutable de checadas, descansos, ajustes y autorizaciones.
model AttendanceEvent {
  id             String              @id @default(cuid())
  organizationId String
  branchId       String?
  shiftId        String?
  /// Empleado al que corresponde la checada.
  userId         String
  type           AttendanceEventType
  occurredAt     DateTime
  recordedById   String?
  source         AttendanceSource    @default(WEB)
  withinGeofence Boolean?
  latitude       Decimal?            @db.Decimal(10, 7)
  longitude      Decimal?            @db.Decimal(10, 7)
  note           String?
  metadata       Json?
  /// Evita duplicar una checada reintentada desde el kiosko/offline.
  idempotencyKey String?             @unique
  createdAt      DateTime            @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  shift        Shift?       @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  recordedBy   User?        @relation("AttendanceEventRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([organizationId, occurredAt])
  @@index([shiftId, occurredAt])
  @@index([userId, occurredAt])
}

enum ScheduleStatus {
  DRAFT
  PUBLISHED
}

/// Horario semanal de una sucursal.
model Schedule {
  id             String         @id @default(cuid())
  organizationId String
  branchId       String?
  /// Lunes de la semana, a medianoche local.
  weekStart      DateTime       @db.Date
  status         ScheduleStatus @default(DRAFT)
  publishedAt    DateTime?
  publishedById  String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch?         @relation(fields: [branchId], references: [id], onDelete: SetNull)
  entries      ScheduleEntry[]

  @@unique([organizationId, branchId, weekStart])
  @@index([organizationId, weekStart])
}

/// Un turno asignado a una persona en un día. Solo uno por día.
model ScheduleEntry {
  id           String   @id @default(cuid())
  scheduleId   String
  userId       String
  date         DateTime @db.Date
  startTime    String // "09:00"
  endTime      String // "18:00"; si es menor que startTime cruza medianoche
  breakMinutes Int      @default(60)
  note         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  schedule Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  shifts   Shift[]

  @@unique([scheduleId, userId, date])
  @@index([userId, date])
}

/// Plantilla reutilizable de horario.
model ShiftTemplate {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  startTime      String
  endTime        String
  breakMinutes   Int      @default(60)
  color          String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, name])
}

/// Motivo de la merma registrada.
enum WasteReason {
  EXPIRED
  DAMAGED
  SPILL
  OVERPRODUCTION
  OTHER
}

/// Merma de un insumo, con costo calculado y evidencia fotográfica.
model Waste {
  id             String      @id @default(cuid())
  organizationId String
  branchId       String?
  ingredientId   String?
  /// Nombre del insumo en el momento del registro (snapshot).
  ingredientName String
  /// Cantidad en la unidad canónica del insumo.
  quantity       Decimal     @db.Decimal(12, 4)
  /// Unidad visible con la que se capturó.
  displayUnit    UnitCode
  reason         WasteReason
  note           String?
  /// Costo de la merma (cantidad canónica × costo del insumo).
  cost           Decimal     @db.Decimal(12, 2)
  photoKey       String?
  photoUrl       String?
  userId         String?
  createdAt      DateTime    @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  ingredient   Ingredient?  @relation(fields: [ingredientId], references: [id], onDelete: SetNull)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([branchId, createdAt])
  @@index([ingredientId])
}

/// Dirección anterior de un negocio.
///
/// Se conserva para que los enlaces y QR ya impresos sigan funcionando: el
/// resolver busca primero la organización y, si no existe, este alias, y la web
/// redirige 301 a la dirección nueva.
model SlugAlias {
  slug           String   @id
  organizationId String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

// ============================================================================
// Cocina avanzada (modo General / Avanzado)
// ============================================================================

model KitchenStation {
  id             String             @id @default(cuid())
  organizationId String
  branchId       String?
  name           String
  code           String
  type           KitchenStationType @default(CUSTOM)
  color          String?
  sortOrder      Int                @default(0)
  isActive       Boolean            @default(true)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch?              @relation(fields: [branchId], references: [id], onDelete: Cascade)
  assignments  KitchenAssignment[]
  tickets      KitchenTicket[]
  routingRules KitchenStationRule[]
  defaultItems Item[]               @relation("ItemDefaultStation")
  orderItems   OrderItem[]

  @@unique([organizationId, branchId, code])
  @@index([organizationId, isActive])
  @@index([branchId, isActive])
}

model KitchenPosition {
  id             String               @id @default(cuid())
  organizationId String
  name           String
  code           String
  level          KitchenPositionLevel @default(COOK)
  permissions    String[]             @default([])
  isSystemPreset Boolean              @default(false)
  isActive       Boolean              @default(true)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships  Membership[]

  @@unique([organizationId, code])
  @@index([organizationId, isActive])
}

model KitchenAssignment {
  id             String   @id @default(cuid())
  organizationId String
  membershipId   String
  stationId      String
  isPrimary      Boolean  @default(false)
  createdAt      DateTime @default(now())

  membership Membership     @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  station    KitchenStation @relation(fields: [stationId], references: [id], onDelete: Cascade)

  @@unique([membershipId, stationId])
  @@index([organizationId])
  @@index([stationId])
}

model KitchenStationRule {
  id             String   @id @default(cuid())
  organizationId String
  branchId       String?
  stationId      String
  itemId         String?
  categoryId     String?
  menuId         String?
  priority       Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  station  KitchenStation @relation(fields: [stationId], references: [id], onDelete: Cascade)
  item     Item?          @relation("ItemStationRule", fields: [itemId], references: [id], onDelete: Cascade)
  category Category?      @relation("CategoryStationRule", fields: [categoryId], references: [id], onDelete: Cascade)
  menu     Menu?          @relation("MenuStationRule", fields: [menuId], references: [id], onDelete: Cascade)

  @@index([organizationId, itemId])
  @@index([organizationId, categoryId])
  @@index([organizationId, menuId])
  @@index([stationId])
}

model KitchenCourse {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  sortOrder      Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  rounds       OrderRound[]

  @@unique([organizationId, name])
  @@index([organizationId, isActive])
}

model KitchenTicket {
  id                   String              @id @default(cuid())
  organizationId       String
  branchId             String?
  orderRoundId         String
  stationId            String
  status               KitchenTicketStatus @default(PENDING)
  assignedMembershipId String?
  createdAt            DateTime            @default(now())
  firedAt              DateTime?
  startedAt            DateTime?
  readyAt              DateTime?
  pickedUpAt           DateTime?
  deliveredAt          DateTime?
  cancelledAt          DateTime?
  cancelReason         String?

  orderRound         OrderRound          @relation(fields: [orderRoundId], references: [id], onDelete: Cascade)
  station            KitchenStation      @relation(fields: [stationId], references: [id], onDelete: Restrict)
  assignedMembership Membership?         @relation("KitchenTicketAssignee", fields: [assignedMembershipId], references: [id], onDelete: SetNull)
  items              KitchenTicketItem[]

  @@unique([orderRoundId, stationId])
  @@index([organizationId, status, createdAt])
  @@index([branchId, status, createdAt])
  @@index([stationId, status])
  @@index([assignedMembershipId])
}

model KitchenTicketItem {
  id            String            @id @default(cuid())
  ticketId      String
  orderItemId   String
  status        KitchenItemStatus @default(PENDING)
  voidReason    String?
  refiredFromId String?

  ticket    KitchenTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  orderItem OrderItem     @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@unique([ticketId, orderItemId])
  @@index([orderItemId])
}
